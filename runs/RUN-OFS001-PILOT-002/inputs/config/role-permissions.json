{
  "schema_version": "0.1.0",
  "default_policy": "deny",
  "roles": {
    "orchestrator": {
      "allowed_write_patterns": [
        "queue/**",
        "runs/**",
        "state/**",
        "reviews/exceptions/**"
      ]
    },
    "directive-ingestor": {
      "allowed_write_patterns": [
        "reviews/directives/**",
        "queue/**",
        "runs/**"
      ]
    },
    "discovery": {
      "allowed_write_patterns": [
        "proposals/sources/**",
        "runs/**"
      ]
    },
    "extraction": {
      "allowed_write_patterns": [
        "proposals/evidence/**",
        "runs/**"
      ]
    },
    "validator": {
      "allowed_write_patterns": [
        "assessments/**",
        "runs/**"
      ]
    },
    "critic": {
      "allowed_write_patterns": [
        "assessments/**",
        "reviews/dissent/**",
        "runs/**"
      ]
    },
    "synthesis": {
      "allowed_write_patterns": [
        "proposals/claims/**",
        "proposals/findings/**",
        "proposals/roadmap-items/**",
        "runs/**"
      ]
    },
    "consensus": {
      "allowed_write_patterns": [
        "decisions/**",
        "runs/**"
      ]
    },
    "promotion": {
      "allowed_write_patterns": [
        "data/**",
        "knowledge/**",
        "roadmaps/**",
        "reports/**",
        "reviews/digests/**",
        "runs/**",
        "TBD.md"
      ]
    },
    "topic-promotion": {
      "allowed_write_patterns": [
        "config/research-baseline.json",
        "config/publication-i18n.json",
        "config/monitors/MON-AUTO-TOPICS-001.json",
        "runs/**"
      ]
    },
    "maintainer": {
      "interactive_human_authorization_required": true,
      "allowed_write_patterns": [
        "**"
      ]
    }
  }
}

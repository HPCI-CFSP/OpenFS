{
  "schema_version": "0.1.0",
  "monitor_id": "MON-EMERGING-TOPICS-001",
  "task_id": "OFS-004",
  "title": "AI-proposed emerging infrastructure research topics",
  "enabled": false,
  "languages": ["ja", "en"],
  "domains": ["architecture", "system-software", "applications", "cross-cutting"],
  "topic_selector": {
    "catalog_ref": "config/research-baseline.json",
    "include_all_active_topics": true,
    "selection_role": "overlap-and-gap-comparison"
  },
  "taxonomy_ref": "config/catalog-taxonomy.json",
  "watch_registry_ref": "config/source-watch-registry.json",
  "proposal_schema_ref": "schemas/research-topic-proposal.schema.json",
  "consensus_policy_ref": "config/consensus-policy.json",
  "promotion_tool_ref": "tools/promote_research_topic.py",
  "source_classes": ["official-primary", "standards-body", "peer-reviewed-research", "project-deliverable", "vendor-primary"],
  "query_families": [
    "future HPC architecture emerging technology roadmap",
    "AI for Science infrastructure emerging workload",
    "HPCI 国内 技術 研究開発 ロードマップ",
    "supercomputing center operations emerging requirements",
    "high performance computing discontinuity risk"
  ],
  "discovery_slots_per_query": 2,
  "minimum_sources_per_query": 2,
  "minimum_evidence_sources_per_claim": 2,
  "candidate_requirements": {
    "minimum_origin_groups": 2,
    "require_catalog_delta": true,
    "require_falsification_query": true,
    "require_independent_review": true,
    "may_remove_initial_topic": false
  },
  "automation_contract": {
    "scheduled_discovery": true,
    "candidate_output": "proposals/research-topics/PRP-TOP-*.json",
    "automatic_promotion_requires_accepted_decision": true,
    "direct_publication_forbidden": true,
    "non_additive_change_requires_human_directive": true
  },
  "maximum_unchecked_days": 1,
  "manual_run_requirement": 3,
  "coverage_status": "design-only"
}

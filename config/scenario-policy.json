{
  "schema_version": "0.1.0",
  "policy_id": "HPCI-SCENARIO-POLICY-001",
  "minimum_scenarios": 3,
  "minimum_pairwise_candidate_domain_differences": 3,
  "minimum_pairwise_fallback_domain_differences": 3,
  "required_sections": [
    "architecture",
    "system_software",
    "applications",
    "center_impacts",
    "technology_options",
    "evaluation",
    "evidence_refs",
    "uncertainties",
    "decision_gates"
  ],
  "required_center_profile_fields": [
    "users",
    "priority_domains",
    "current_system",
    "refresh_window",
    "power",
    "facility",
    "budget",
    "procurement",
    "software",
    "operations",
    "migration",
    "data_connectivity"
  ],
  "evaluation_criteria": [
    {"criterion_id": "application-coverage", "title_ja": "アプリケーション・利用者適合性", "weight": null},
    {"criterion_id": "time-to-solution", "title_ja": "性能・応答・スループット", "weight": null},
    {"criterion_id": "power-facility-fit", "title_ja": "電力・冷却・建屋適合性", "weight": null},
    {"criterion_id": "lifecycle-cost", "title_ja": "調達・運用・移行を含むライフサイクル費用", "weight": null},
    {"criterion_id": "maturity-schedule", "title_ja": "技術成熟度・供給・導入時期", "weight": null},
    {"criterion_id": "software-migration", "title_ja": "ソフトウェア継続性・移行容易性", "weight": null},
    {"criterion_id": "operations-security", "title_ja": "運用性・人材・セキュリティ", "weight": null},
    {"criterion_id": "hpci-interoperability", "title_ja": "HPCI相互運用性・データ継続性", "weight": null},
    {"criterion_id": "technology-origin-and-ecosystem", "title_ja": "世界技術動向・日本発技術・供給網・産業波及", "weight": null},
    {"criterion_id": "center-fit", "title_ja": "センター別制約・更新計画への適合", "weight": null},
    {"criterion_id": "reversibility", "title_ja": "不確実性への可逆性・段階導入性", "weight": null}
  ],
  "score_scale": {"minimum": 1, "maximum": 5, "unknown": null},
  "weight_rule": "Weights require a reviewed human Directive. Until then, publish side-by-side scores without a total ranking.",
  "mandatory_constraints": [
    "Use accepted or clearly labeled provisional evidence only",
    "Cover architecture, system software, and applications as one plan",
    "Include center-specific impacts and uncovered center data",
    "Research worldwide technology options, prioritize coverage of technologies developed in Japan, and record maturity and fallback",
    "Preserve uncertainties, dissent, and decision gates",
    "Do not promote a high-impact recommendation without human approval"
  ],
  "publication": {
    "markdown_path": "reports/drafts/system-scenarios.md",
    "json_path": "reports/exports/system-scenarios.json",
    "show_unranked_when_weights_missing": true,
    "include_traceability": true
  }
}

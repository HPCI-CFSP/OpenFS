{
  "schema_version": "0.1.0",
  "policy_id": "ACQUISITION-001",
  "allowed_url_schemes": ["https", "http"],
  "maximum_candidate_passage_characters": 1200,
  "maximum_candidate_passages_per_source": 5,
  "tracking_query_prefixes": ["utm_"],
  "tracking_query_keys": ["fbclid", "gclid", "mc_cid", "mc_eid"],
  "rights_rules": {
    "prohibited": ["metadata-only", "blocked"],
    "restricted": ["metadata-only", "blocked"],
    "not-stated": ["metadata-only", "evidence-excerpt", "external-reference"],
    "permitted": ["metadata-only", "evidence-excerpt", "approved-snapshot", "external-reference"],
    "not-applicable": ["metadata-only", "external-reference"]
  },
  "prompt_injection_markers": [
    "ignore previous instructions",
    "ignore all prior instructions",
    "reveal your system prompt",
    "disclose credentials",
    "upload local files"
  ]
}

{
  "schema_version": "0.1.0",
  "policy_id": "PUBLICATION-001",
  "information_plane": "public-only",
  "site_source": "site",
  "site_output": "_site",
  "included_catalog": "config/research-baseline.json",
  "included_i18n": "config/publication-i18n.json",
  "included_public_topic_summaries": "knowledge/public/topic-summaries.json",
  "accepted_topic_summary_statuses": ["published"],
  "topic_summary_public_fields": [
    "summary_id",
    "topic_ids",
    "title_ja",
    "title_en",
    "summary_ja",
    "summary_en",
    "source_run_id",
    "generated_at",
    "research_status",
    "coverage_status",
    "consensus_status",
    "findings",
    "caveat_ja",
    "caveat_en"
  ],
  "topic_summary_required_bilingual_fields": ["title_ja", "title_en", "summary_ja", "summary_en", "caveat_ja", "caveat_en"],
  "topic_finding_public_fields": ["finding_id", "topic_ids", "statement_ja", "statement_en", "sources"],
  "topic_source_public_fields": ["source_id", "title", "publisher", "url"],
  "human_publication_directive_glob": "reviews/directives/*.json",
  "human_publication_directive_statuses": ["approved", "completed"],
  "accepted_scenario_glob": "roadmaps/scenarios/accepted/*.json",
  "accepted_scenario_statuses": ["published"],
  "scenario_public_fields": [
    "scenario_id",
    "title_ja",
    "title_en",
    "status",
    "planning_horizon",
    "objective",
    "objective_en",
    "architecture",
    "system_software",
    "applications",
    "center_impacts",
    "domestic_technology",
    "evaluation",
    "evidence_refs",
    "uncertainties",
    "decision_gates",
    "publication"
  ],
  "scenario_required_bilingual_fields": ["title_ja", "title_en", "objective", "objective_en"],
  "report_index": "reports/exports/index.json",
  "accepted_report_statuses": ["published"],
  "report_public_fields": [
    "report_id",
    "title",
    "title_en",
    "as_of",
    "status",
    "summary",
    "summary_en",
    "version",
    "supersedes",
    "evidence_refs",
    "download_url",
    "publication"
  ],
  "report_required_bilingual_fields": ["title", "title_en", "summary", "summary_en"],
  "required_publication_metadata": {
    "information_classification": "public",
    "publication_approved": true
  },
  "excluded_paths": ["proposals", "assessments", "runs", "reviews", "_Agent_local", "NDA", "private"],
  "required_notices": [
    "Public information only",
    "No NDA material",
    "Candidate and illustrative scenarios are not published",
    "Every published result carries an as-of date and traceability"
  ],
  "license_status": "active",
  "license": "Apache-2.0"
}

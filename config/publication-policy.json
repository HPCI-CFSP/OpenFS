{
  "schema_version": "0.1.0",
  "policy_id": "PUBLICATION-001",
  "information_plane": "public-only",
  "site_source": "site",
  "site_output": "_site",
  "included_catalog": "config/research-baseline.json",
  "accepted_scenario_glob": "roadmaps/scenarios/accepted/*.json",
  "accepted_scenario_statuses": ["published"],
  "scenario_public_fields": [
    "scenario_id",
    "title_ja",
    "status",
    "planning_horizon",
    "objective",
    "architecture",
    "system_software",
    "applications",
    "center_impacts",
    "domestic_technology",
    "evaluation",
    "evidence_refs",
    "uncertainties",
    "decision_gates",
    "publication"
  ],
  "report_index": "reports/exports/index.json",
  "accepted_report_statuses": ["published"],
  "report_public_fields": [
    "report_id",
    "title",
    "as_of",
    "status",
    "summary",
    "version",
    "supersedes",
    "evidence_refs",
    "download_url",
    "publication"
  ],
  "required_publication_metadata": {
    "information_classification": "public",
    "publication_approved": true
  },
  "excluded_paths": ["proposals", "assessments", "runs", "reviews", "_Agent_local", "NDA", "private"],
  "required_notices": [
    "Public information only",
    "No NDA material",
    "Candidate and illustrative scenarios are not published",
    "Every published result carries an as-of date and traceability"
  ],
  "license_status": "pending-human-decision",
  "recommended_license": "Apache-2.0"
}

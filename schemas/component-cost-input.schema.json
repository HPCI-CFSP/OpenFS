{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/component-cost-input.schema.json",
  "title": "Traceable Component Cost and Sizing Input v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "cost_input_id", "status", "information_classification",
    "input_mode", "as_of", "currency", "tax_basis", "price_basis_year", "packages"
  ],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "cost_input_id": {"type": "string", "pattern": "^COSTINPUT-[A-Z0-9-]+$"},
    "status": {"enum": ["candidate", "synthetic-test-only"]},
    "information_classification": {"enum": ["public", "local-user-input"]},
    "input_mode": {"enum": ["public-evidence", "what-if-template", "synthetic-test-only", "user-input"]},
    "as_of": {"type": "string", "format": "date"},
    "currency": {"const": "JPY"},
    "tax_basis": {"enum": ["excluding-tax", "including-tax", "unknown"]},
    "price_basis_year": {"type": "integer", "minimum": 2020, "maximum": 2100},
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/package"}
    }
  },
  "$defs": {
    "numberOrNull": {"type": ["number", "null"], "minimum": 0},
    "integerOrNull": {"type": ["integer", "null"], "minimum": 0},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id", "vendor", "product_id", "product_label",
        "allow_product_override", "unit_type", "gpus_per_unit",
        "host_cpus_per_unit", "units_per_rack", "nodes_per_unit",
        "trays_per_unit", "power_kw_per_unit", "hbm_gib_per_gpu",
        "host_memory_gib_per_unit", "local_nvme_tb_per_unit",
        "rack_footprint_m2", "rack_weight_kg", "include_auxiliary_racks", "spare_percent",
        "portability_risk_score", "network", "storage_capability",
        "service_sizing", "power_profile", "procurement_assumption",
        "cost_lines", "source_ids"
      ],
      "properties": {
        "package_id": {"type": "string", "pattern": "^PKG-[A-Z0-9-]+$"},
        "vendor": {"enum": ["NVIDIA", "AMD"]},
        "product_id": {"type": "string", "pattern": "^GPU-[A-Z0-9-]+$"},
        "product_label": {"type": "string", "minLength": 1},
        "allow_product_override": {"type": "boolean"},
        "unit_type": {"type": ["string", "null"], "enum": ["node", "tray", "rack", null]},
        "gpus_per_unit": {"$ref": "#/$defs/integerOrNull"},
        "host_cpus_per_unit": {"$ref": "#/$defs/integerOrNull"},
        "units_per_rack": {"$ref": "#/$defs/integerOrNull"},
        "nodes_per_unit": {"$ref": "#/$defs/integerOrNull"},
        "trays_per_unit": {"$ref": "#/$defs/integerOrNull"},
        "power_kw_per_unit": {"$ref": "#/$defs/numberOrNull"},
        "hbm_gib_per_gpu": {"$ref": "#/$defs/numberOrNull"},
        "host_memory_gib_per_unit": {"$ref": "#/$defs/numberOrNull"},
        "local_nvme_tb_per_unit": {"$ref": "#/$defs/numberOrNull"},
        "rack_footprint_m2": {"$ref": "#/$defs/numberOrNull"},
        "rack_weight_kg": {"$ref": "#/$defs/numberOrNull"},
        "include_auxiliary_racks": {"type": "boolean"},
        "spare_percent": {"$ref": "#/$defs/numberOrNull"},
        "portability_risk_score": {"$ref": "#/$defs/numberOrNull"},
        "network": {"$ref": "#/$defs/network"},
        "storage_capability": {"$ref": "#/$defs/storage"},
        "service_sizing": {"$ref": "#/$defs/services"},
        "power_profile": {"$ref": "#/$defs/power"},
        "procurement_assumption": {"$ref": "#/$defs/procurement"},
        "cost_lines": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/costLine"}
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topology", "endpoint_ports_per_unit", "nics_per_unit",
        "switch_ports", "max_port_utilization", "redundant_switches",
        "max_switch_count", "optics_per_endpoint", "cables_per_endpoint",
        "blocking_ratio"
      ],
      "properties": {
        "topology": {"type": "string"},
        "endpoint_ports_per_unit": {"$ref": "#/$defs/numberOrNull"},
        "nics_per_unit": {"$ref": "#/$defs/numberOrNull"},
        "switch_ports": {"$ref": "#/$defs/integerOrNull"},
        "max_port_utilization": {"$ref": "#/$defs/numberOrNull"},
        "redundant_switches": {"$ref": "#/$defs/integerOrNull"},
        "max_switch_count": {"$ref": "#/$defs/integerOrNull"},
        "optics_per_endpoint": {"$ref": "#/$defs/numberOrNull"},
        "cables_per_endpoint": {"$ref": "#/$defs/numberOrNull"},
        "blocking_ratio": {"$ref": "#/$defs/numberOrNull"}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fast_capacity_pb_per_appliance", "fast_read_gb_s_per_appliance",
        "fast_write_gb_s_per_appliance",
        "metadata_million_inodes_per_appliance",
        "archive_capacity_pb_per_appliance", "minimum_controller_count",
        "max_fast_storage_appliances", "max_archive_storage_appliances",
        "controllers_per_appliance", "appliances_per_rack"
      ],
      "properties": {
        "fast_capacity_pb_per_appliance": {"$ref": "#/$defs/numberOrNull"},
        "fast_read_gb_s_per_appliance": {"$ref": "#/$defs/numberOrNull"},
        "fast_write_gb_s_per_appliance": {"$ref": "#/$defs/numberOrNull"},
        "metadata_million_inodes_per_appliance": {"$ref": "#/$defs/numberOrNull"},
        "archive_capacity_pb_per_appliance": {"$ref": "#/$defs/numberOrNull"},
        "minimum_controller_count": {"$ref": "#/$defs/integerOrNull"},
        "max_fast_storage_appliances": {"$ref": "#/$defs/integerOrNull"},
        "max_archive_storage_appliances": {"$ref": "#/$defs/integerOrNull"},
        "controllers_per_appliance": {"$ref": "#/$defs/numberOrNull"},
        "appliances_per_rack": {"$ref": "#/$defs/integerOrNull"}
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "login_min_nodes", "concurrent_users_per_login_node",
        "management_min_nodes", "compute_units_per_management_node",
        "monitoring_min_nodes", "compute_units_per_monitoring_node",
        "provisioning_min_nodes", "compute_units_per_provisioning_node",
        "scheduler_min_nodes", "authentication_min_nodes", "nodes_per_rack"
      ],
      "properties": {
        "login_min_nodes": {"$ref": "#/$defs/integerOrNull"},
        "concurrent_users_per_login_node": {"$ref": "#/$defs/numberOrNull"},
        "management_min_nodes": {"$ref": "#/$defs/integerOrNull"},
        "compute_units_per_management_node": {"$ref": "#/$defs/numberOrNull"},
        "monitoring_min_nodes": {"$ref": "#/$defs/integerOrNull"},
        "compute_units_per_monitoring_node": {"$ref": "#/$defs/numberOrNull"},
        "provisioning_min_nodes": {"$ref": "#/$defs/integerOrNull"},
        "compute_units_per_provisioning_node": {"$ref": "#/$defs/numberOrNull"},
        "scheduler_min_nodes": {"$ref": "#/$defs/integerOrNull"},
        "authentication_min_nodes": {"$ref": "#/$defs/integerOrNull"},
        "nodes_per_rack": {"$ref": "#/$defs/integerOrNull"}
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "switch_kw", "nic_kw", "fast_storage_appliance_kw",
        "archive_storage_appliance_kw", "service_node_kw"
      ],
      "properties": {
        "switch_kw": {"$ref": "#/$defs/numberOrNull"},
        "nic_kw": {"$ref": "#/$defs/numberOrNull"},
        "fast_storage_appliance_kw": {"$ref": "#/$defs/numberOrNull"},
        "archive_storage_appliance_kw": {"$ref": "#/$defs/numberOrNull"},
        "service_node_kw": {"$ref": "#/$defs/numberOrNull"}
      }
    },
    "procurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "latest_delivery_date", "support_status"],
      "properties": {
        "eligible": {"type": ["boolean", "null"]},
        "latest_delivery_date": {"type": ["string", "null"], "format": "date"},
        "support_status": {"type": "string"}
      }
    },
    "costLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id", "label_ja", "label_en", "category", "basis", "period",
        "optimistic_jpy", "baseline_jpy", "conservative_jpy",
        "evidence_status", "as_of", "currency", "tax_basis",
        "scope_note", "source_ids"
      ],
      "properties": {
        "scope_id": {"type": "string", "pattern": "^COSTSCOPE-[A-Z0-9-]+$"},
        "label_ja": {"type": "string"},
        "label_en": {"type": "string"},
        "category": {
          "enum": [
            "compute", "scale-up", "scale-out", "network", "fast-storage",
            "archive-storage", "management", "facility", "software",
            "integration", "maintenance", "spares", "hosting", "energy",
            "operations", "decommissioning"
          ]
        },
        "basis": {
          "enum": [
            "fixed", "per-compute-unit", "per-rack",
            "per-fast-storage-appliance", "per-archive-storage-appliance",
            "per-network-switch", "per-nic", "per-optic", "per-cable",
            "per-service-node", "per-storage-controller", "per-it-kw",
            "per-fast-storage-pb", "per-archive-storage-pb"
          ]
        },
        "period": {"enum": ["initial", "annual", "end-of-horizon"]},
        "optimistic_jpy": {"$ref": "#/$defs/numberOrNull"},
        "baseline_jpy": {"$ref": "#/$defs/numberOrNull"},
        "conservative_jpy": {"$ref": "#/$defs/numberOrNull"},
        "evidence_status": {"enum": ["observed-itemized", "vendor-quote", "validated-estimate", "user-assumption", "synthetic-test-only", "missing"]},
        "as_of": {"type": ["string", "null"], "format": "date"},
        "currency": {"const": "JPY"},
        "tax_basis": {"enum": ["excluding-tax", "including-tax", "unknown"]},
        "scope_note": {"type": "string"},
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

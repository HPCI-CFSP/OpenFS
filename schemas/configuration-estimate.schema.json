{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/configuration-estimate.schema.json",
  "title": "Candidate GPU-centric Configuration Estimate v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "status",
    "research_status",
    "consensus_status",
    "procurement_use",
    "calculation_mode",
    "request_id",
    "architecture_id",
    "product_catalog_id",
    "availability_assessment_id",
    "cost_input_id",
    "generated_at",
    "engine_version",
    "vendor_candidates",
    "pareto_result",
    "benchmark_candidates",
    "messages_ja",
    "messages_en"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "result_id": {
      "type": "string",
      "pattern": "^CFGRESULT-[A-Z0-9-]+$"
    },
    "status": {
      "enum": [
        "blocked",
        "partial",
        "feasible"
      ]
    },
    "research_status": {
      "const": "provisional"
    },
    "consensus_status": {
      "const": "incomplete"
    },
    "procurement_use": {
      "const": "prohibited"
    },
    "calculation_mode": {
      "enum": [
        "public-evidence",
        "what-if"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^PLANREQ-[A-Z0-9-]+$"
    },
    "architecture_id": {
      "const": "ARCH-GPU-CENTRIC-AI4S-001"
    },
    "product_catalog_id": {
      "type": "string",
      "pattern": "^GPUCAT-[A-Z0-9-]+$"
    },
    "availability_assessment_id": {
      "type": "string",
      "pattern": "^AVAIL-[A-Z0-9-]+$"
    },
    "cost_input_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^COSTINPUT-[A-Z0-9-]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "engine_version": {
      "const": "0.2.0"
    },
    "vendor_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vendor",
          "product_id",
          "product_name",
          "availability_status",
          "status",
          "software_profile",
          "portability_risk_score",
          "cases",
          "gaps"
        ],
        "properties": {
          "vendor": {
            "enum": [
              "NVIDIA",
              "AMD"
            ]
          },
          "product_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "product_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "availability_status": {
            "enum": [
              "eligible",
              "conditional",
              "ineligible",
              "unknown",
              "not-assessed",
              "user-assumption"
            ]
          },
          "status": {
            "enum": [
              "blocked",
              "partial",
              "feasible"
            ]
          },
          "software_profile": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "portability_risk_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "cases": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "case_ref",
                "price_case",
                "status",
                "blocking_reason",
                "unit_type",
                "quantities",
                "power",
                "costs",
                "tco",
                "constraints",
                "performance",
                "gap_ids"
              ],
              "properties": {
                "case_ref": {
                  "type": "string"
                },
                "price_case": {
                  "enum": [
                    "optimistic",
                    "baseline",
                    "conservative"
                  ]
                },
                "status": {
                  "enum": [
                    "blocked",
                    "partial",
                    "feasible"
                  ]
                },
                "blocking_reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "unit_type": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "node",
                    "tray",
                    "rack",
                    null
                  ]
                },
                "quantities": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": {
                    "type": [
                      "number",
                      "integer",
                      "null"
                    ]
                  }
                },
                "power": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  }
                },
                "costs": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "configuration_cost_jpy",
                    "contingency_jpy",
                    "unused_budget_jpy",
                    "budget_ceiling_jpy",
                    "identity_verified",
                    "line_items"
                  ],
                  "properties": {
                    "configuration_cost_jpy": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "contingency_jpy": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "unused_budget_jpy": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "budget_ceiling_jpy": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "identity_verified": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "line_items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "scope_id",
                          "category",
                          "basis",
                          "quantity",
                          "unit_price_jpy",
                          "subtotal_jpy",
                          "evidence_status",
                          "source_ids"
                        ],
                        "properties": {
                          "scope_id": {
                            "type": "string"
                          },
                          "category": {
                            "type": "string"
                          },
                          "basis": {
                            "type": "string"
                          },
                          "quantity": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "unit_price_jpy": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "subtotal_jpy": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "evidence_status": {
                            "type": "string"
                          },
                          "source_ids": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "tco": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "years",
                    "initial_capex_jpy",
                    "recurring_cost_jpy",
                    "end_of_horizon_cost_jpy",
                    "total_tco_jpy",
                    "complete",
                    "annual_breakdown"
                  ],
                  "properties": {
                    "years": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "initial_capex_jpy": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "recurring_cost_jpy": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "end_of_horizon_cost_jpy": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "total_tco_jpy": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "complete": {
                      "type": "boolean"
                    },
                    "annual_breakdown": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "scope_id",
                          "category",
                          "basis",
                          "quantity",
                          "unit_price_jpy",
                          "subtotal_jpy",
                          "evidence_status",
                          "source_ids"
                        ],
                        "properties": {
                          "scope_id": {
                            "type": "string"
                          },
                          "category": {
                            "type": "string"
                          },
                          "basis": {
                            "type": "string"
                          },
                          "quantity": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "unit_price_jpy": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "subtotal_jpy": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "evidence_status": {
                            "type": "string"
                          },
                          "source_ids": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "constraints": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "actual",
                      "limit",
                      "unit",
                      "shortfall",
                      "detail"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "pass",
                          "fail",
                          "unknown"
                        ]
                      },
                      "actual": {
                        "type": [
                          "number",
                          "integer",
                          "string",
                          "boolean",
                          "null"
                        ]
                      },
                      "limit": {
                        "type": [
                          "number",
                          "integer",
                          "string",
                          "boolean",
                          "null"
                        ]
                      },
                      "unit": {
                        "type": "string"
                      },
                      "shortfall": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": 0
                      },
                      "detail": {
                        "type": "string"
                      }
                    }
                  }
                },
                "performance": {
                  "type": "object",
                  "required": [
                    "status",
                    "procurement_use"
                  ],
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "procurement_use": {
                      "const": "prohibited"
                    }
                  },
                  "additionalProperties": true
                },
                "gap_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^GAP-GPUCFG-[0-9]{3}$"
                  }
                }
              }
            }
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "gap_id",
                "scope",
                "statement_ja",
                "statement_en",
                "missing_items"
              ],
              "properties": {
                "gap_id": {
                  "type": "string",
                  "pattern": "^GAP-GPUCFG-[0-9]{3}$"
                },
                "scope": {
                  "type": "string"
                },
                "statement_ja": {
                  "type": "string"
                },
                "statement_en": {
                  "type": "string"
                },
                "missing_items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "pareto_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "objectives",
        "candidate_refs",
        "reason_ja",
        "reason_en"
      ],
      "properties": {
        "status": {
          "enum": [
            "computed",
            "not-evaluable",
            "not-requested"
          ]
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "candidate_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "reason_ja": {
          "type": "string"
        },
        "reason_en": {
          "type": "string"
        }
      }
    },
    "benchmark_candidates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "messages_ja": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "messages_en": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    }
  }
}

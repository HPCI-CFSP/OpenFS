{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/system-scenario.schema.json",
  "title": "System Planning Option",
  "type": "object",
  "required": [
    "schema_version",
    "scenario_id",
    "title_ja",
    "status",
    "plan_version",
    "effective_from",
    "review_due",
    "supersedes",
    "planning_horizon",
    "objective",
    "architecture",
    "system_software",
    "applications",
    "center_impacts",
    "technology_options",
    "budget_options",
    "context_notes",
    "implementation_path",
    "evaluation",
    "evidence_refs",
    "uncertainties",
    "decision_gates"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "scenario_id": {"type": "string", "pattern": "^SCN-[A-Z0-9-]+$"},
    "title_ja": {"type": "string", "minLength": 1},
    "title_en": {"type": "string", "minLength": 1},
    "research_status": {"enum": ["provisional", "accepted"]},
    "consensus_status": {"enum": ["incomplete", "accepted"]},
    "status": {"enum": ["illustrative-example", "candidate", "under-review", "accepted", "published", "rejected", "superseded"]},
    "plan_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "effective_from": {"type": "string", "format": "date"},
    "review_due": {"type": "string", "format": "date"},
    "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SCN-[A-Z0-9-]+@[0-9]+\\.[0-9]+$"}},
    "planning_horizon": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "objective_en": {"type": "string", "minLength": 1},
    "architecture": {"type": "object", "minProperties": 1},
    "system_software": {"type": "object", "minProperties": 1},
    "applications": {"type": "object", "minProperties": 1},
    "center_impacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["center_group", "fit", "migration", "unverified_conditions"],
        "properties": {
          "center_group": {"type": "string", "minLength": 1},
          "center_group_en": {"type": "string", "minLength": 1},
          "fit": {"type": "string", "minLength": 1},
          "fit_en": {"type": "string", "minLength": 1},
          "migration": {"type": "string", "minLength": 1},
          "migration_en": {"type": "string", "minLength": 1},
          "unverified_conditions": {"type": "array", "items": {"type": "string"}},
          "unverified_conditions_en": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "technology_options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["option_id", "domain", "candidate", "role", "maturity_gate", "fallback", "evidence_refs"],
        "properties": {
          "option_id": {"type": "string", "pattern": "^TOPT-[A-Z0-9-]+$"},
          "domain": {"enum": ["compute", "memory", "interconnect", "system-software", "applications"]},
          "candidate": {"type": "string", "minLength": 1},
          "candidate_en": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "role_en": {"type": "string", "minLength": 1},
          "maturity_gate": {"type": "string", "minLength": 1},
          "maturity_gate_en": {"type": "string", "minLength": 1},
          "fallback": {"type": "string", "minLength": 1},
          "fallback_en": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "budget_options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/budgetOption"}
    },
    "context_notes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/contextNote"}
    },
    "implementation_path": {"$ref": "#/$defs/implementationPath"},
    "evaluation": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["score", "rationale", "evidence_refs"],
        "properties": {
          "score": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
          "rationale": {"type": "string", "minLength": 1},
          "rationale_en": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "decision_blocking_gap_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^GAP-[A-Z0-9-]+$"}
    },
    "decision_evidence_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/decisionEvidenceContract"}
    },
    "uncertainties": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "uncertainties_en": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "decision_gates": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "decision_gates_en": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "caveat_ja": {"type": "string", "minLength": 1},
    "caveat_en": {"type": "string", "minLength": 1},
    "publication": {
      "type": "object",
      "required": ["information_classification", "publication_approved", "publication_decision_id", "human_approval_directive_id", "approved_at"],
      "properties": {
        "information_classification": {"const": "public"},
        "publication_approved": {"const": true},
        "publication_decision_id": {"type": "string", "minLength": 1},
        "human_approval_directive_id": {"type": "string", "pattern": "^DIR-[0-9]{6}$"},
        "approved_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "published"}}},
      "then": {"required": ["title_en", "objective_en", "research_status", "consensus_status", "decision_blocking_gap_refs", "uncertainties_en", "decision_gates_en", "caveat_ja", "caveat_en", "publication"]}
    }
  ],
  "$defs": {
    "budgetOption": {
      "type": "object",
      "required": ["option_id", "tier", "label_ja", "label_en", "budget_range_oku_jpy", "estimate_method_ja", "estimate_method_en", "confidence", "reference_case_ids", "components", "aggregate", "caveat_ja", "caveat_en"],
      "properties": {
        "option_id": {"type": "string", "pattern": "^BUD-[A-Z0-9-]+$"},
        "tier": {"type": "string", "pattern": "^(ume|take|matsu|jpy-[0-9]+(\\.[0-9]+)?)$"},
        "budget_allocation": {"$ref": "#/$defs/budgetAllocation"},
        "label_ja": {"type": "string", "minLength": 1},
        "label_en": {"type": "string", "minLength": 1},
        "budget_range_oku_jpy": {
          "type": "object",
          "required": ["lower", "reference", "upper"],
          "properties": {
            "lower": {"type": "number", "minimum": 0},
            "reference": {"type": "number", "minimum": 0},
            "upper": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        },
        "estimate_method_ja": {"type": "string", "minLength": 1},
        "estimate_method_en": {"type": "string", "minLength": 1},
        "confidence": {"const": "low"},
        "reference_case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^BREF-[A-Z0-9-]+$"}},
        "components": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["component_id", "component_type", "label_ja", "label_en", "quantity", "unit_ja", "unit_en", "role_ja", "role_en", "connection_ids"],
            "properties": {
              "component_id": {"type": "string", "pattern": "^BCMP-[A-Z0-9-]+$"},
              "component_type": {"enum": ["compute-cpu", "compute-accelerator", "large-memory", "pilot", "interconnect", "storage", "management", "facility"]},
              "label_ja": {"type": "string", "minLength": 1},
              "label_en": {"type": "string", "minLength": 1},
              "quantity": {"type": ["number", "null"], "minimum": 0},
              "unit_ja": {"type": "string", "minLength": 1},
              "unit_en": {"type": "string", "minLength": 1},
              "role_ja": {"type": "string", "minLength": 1},
              "role_en": {"type": "string", "minLength": 1},
              "connection_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^BCMP-[A-Z0-9-]+$"}}
            },
            "additionalProperties": false
          }
        },
        "aggregate": {
          "type": "object",
          "required": ["cpu_nodes", "accelerator_nodes", "accelerators", "storage_pb", "facility_class_ja", "facility_class_en"],
          "properties": {
            "cpu_nodes": {"type": ["integer", "null"], "minimum": 0},
            "accelerator_nodes": {"type": ["integer", "null"], "minimum": 0},
            "accelerators": {"type": ["integer", "null"], "minimum": 0},
            "storage_pb": {"type": ["number", "null"], "minimum": 0},
            "facility_class_ja": {"type": "string", "minLength": 1},
            "facility_class_en": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "caveat_ja": {"type": "string", "minLength": 1},
        "caveat_en": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "budgetAllocation": {
      "type": "object", "additionalProperties": false,
      "required": ["budget_ceiling_oku_jpy", "deployment_year", "price_basis_year", "tax_basis", "basis", "feasibility_status", "allocations", "tco_years", "tco_oku_jpy", "gap_ids"],
      "properties": {
        "budget_ceiling_oku_jpy": {"type": "number", "exclusiveMinimum": 0, "maximum": 100000},
        "deployment_year": {"type": "integer", "minimum": 2020, "maximum": 2100},
        "price_basis_year": {"type": "integer", "minimum": 2020},
        "tax_basis": {"const": "excluding-tax"}, "basis": {"const": "openfs-planning-assumption"},
        "feasibility_status": {"const": "unverified"},
        "tco_years": {"type": "integer", "minimum": 1}, "tco_oku_jpy": {"type": "null"},
        "gap_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^PCG-[0-9]+$"}},
        "allocations": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "label_ja", "label_en", "unit_ja", "unit_en", "share_percent", "allocation_oku_jpy", "estimated_cost_oku_jpy", "quantity"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "label_ja": {"type": "string", "minLength": 1}, "label_en": {"type": "string", "minLength": 1},
              "unit_ja": {"type": "string", "minLength": 1}, "unit_en": {"type": "string", "minLength": 1},
              "share_percent": {"type": "number", "minimum": 0, "maximum": 100},
              "allocation_oku_jpy": {"type": "number", "minimum": 0},
              "estimated_cost_oku_jpy": {"type": "null"}, "quantity": {"type": "null"}
            }
          }
        }
      }
    },
    "quarterPoint": {
      "type": "object",
      "required": ["year", "quarter"],
      "properties": {
        "year": {"type": "integer", "minimum": 2020, "maximum": 2100},
        "quarter": {"enum": ["Q1", "Q2", "Q3", "Q4"]}
      },
      "additionalProperties": false
    },
    "contextNote": {
      "type": "object",
      "required": ["note_id", "scope", "note_ja", "note_en", "evidence_refs"],
      "properties": {
        "note_id": {"type": "string", "pattern": "^CTX-[A-Z0-9-]+$"},
        "scope": {"enum": ["reusable", "hpci-specific"]},
        "note_ja": {"type": "string", "minLength": 1},
        "note_en": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "implementationPhase": {
      "type": "object",
      "required": ["phase_id", "domain", "title_ja", "title_en", "stage", "timing_basis", "start", "end", "condition_ja", "condition_en", "dependency_refs", "evidence_refs", "consensus_status", "context_scope"],
      "properties": {
        "phase_id": {"type": "string", "pattern": "^SPH-[A-Z0-9-]+$"},
        "domain": {"enum": ["portfolio", "compute", "memory", "interconnect", "storage-data", "system-software", "applications", "facility-operations", "procurement-governance"]},
        "title_ja": {"type": "string", "minLength": 1},
        "title_en": {"type": "string", "minLength": 1},
        "stage": {"enum": ["research", "evaluation", "pilot", "decision", "deployment", "expansion", "operation", "retirement"]},
        "timing_basis": {"const": "openfs-provisional-plan"},
        "start": {"$ref": "#/$defs/quarterPoint"},
        "end": {"$ref": "#/$defs/quarterPoint"},
        "condition_ja": {"type": "string", "minLength": 1},
        "condition_en": {"type": "string", "minLength": 1},
        "dependency_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "consensus_status": {"enum": ["incomplete", "accepted"]},
        "context_scope": {"enum": ["reusable", "hpci-specific"]}
      },
      "additionalProperties": false
    },
    "implementationPath": {
      "type": "object",
      "required": ["start_year", "end_year", "timeline_granularity", "phases"],
      "properties": {
        "start_year": {"type": "integer", "minimum": 2020, "maximum": 2100},
        "end_year": {"type": "integer", "minimum": 2020, "maximum": 2100},
        "timeline_granularity": {"const": "quarter"},
        "phases": {"type": "array", "minItems": 9, "items": {"$ref": "#/$defs/implementationPhase"}}
      },
      "additionalProperties": false
    },
    "decisionEvidenceContract": {
      "type": "object",
      "required": ["contract_id", "title_ja", "title_en", "schema_paths", "validator_paths", "gap_refs", "effect_ja", "effect_en", "acceptance_effect"],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^DCTR-[A-Z0-9-]+$"},
        "title_ja": {"type": "string", "minLength": 1},
        "title_en": {"type": "string", "minLength": 1},
        "schema_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^schemas/[A-Za-z0-9._-]+\\.schema\\.json$"}},
        "validator_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^tools/[A-Za-z0-9._-]+\\.py$"}},
        "gap_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^GAP-[A-Z0-9-]+$"}},
        "effect_ja": {"type": "string", "minLength": 1},
        "effect_en": {"type": "string", "minLength": 1},
        "acceptance_effect": {"const": "candidate-only"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

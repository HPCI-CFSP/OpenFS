{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/export-package.schema.json",
  "title": "OpenFS NDA-to-Public Export Package",
  "type": "object",
  "required": ["schema_version", "export_package_id", "public_statement", "classification", "prohibited_field_check", "dlp_result", "approved_by", "approved_at", "public_destination", "package_hash"],
  "properties": {
    "schema_version": {"type": "string"},
    "export_package_id": {"type": "string"},
    "public_statement": {"type": "string", "minLength": 1},
    "classification": {"enum": ["approved-public", "approved-public-with-expiry"]},
    "transformation_description": {"type": "string"},
    "prohibited_field_check": {"enum": ["pass", "fail"]},
    "dlp_result": {"enum": ["pass", "fail"]},
    "approved_by": {"type": "string"},
    "approved_at": {"type": "string", "format": "date-time"},
    "review_at": {"type": "string", "format": "date-time"},
    "public_destination": {"type": "string"},
    "package_hash": {"type": "string"}
  },
  "additionalProperties": false
}

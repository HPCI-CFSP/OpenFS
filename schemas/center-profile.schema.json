{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/center-profile.schema.json",
  "title": "HPCI Center Profile",
  "type": "object",
  "required": [
    "schema_version",
    "center_id",
    "name_ja",
    "profile_status",
    "evidence_as_of",
    "evidence_refs",
    "users",
    "priority_domains",
    "current_system",
    "refresh_window",
    "power",
    "facility",
    "software",
    "operations",
    "migration",
    "data_connectivity",
    "unknowns"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "center_id": {"type": "string", "pattern": "^CENTER-[A-Z0-9-]+$"},
    "name_ja": {"type": "string", "minLength": 1},
    "profile_status": {"enum": ["draft", "provisional", "reviewed", "accepted", "stale"]},
    "evidence_as_of": {"type": "string", "format": "date"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "users": {"type": "object"},
    "priority_domains": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "current_system": {"type": "object"},
    "refresh_window": {"type": "object"},
    "power": {"type": "object"},
    "facility": {"type": "object"},
    "software": {"type": "object"},
    "operations": {"type": "object"},
    "migration": {"type": "object"},
    "data_connectivity": {"type": "object"},
    "unknowns": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

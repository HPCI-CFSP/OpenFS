{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/worker-result.schema.json",
  "title": "OpenFS Provider Worker Result",
  "type": "object",
  "required": ["schema_version", "result_id", "invocation_id", "invocation_digest", "agent_id", "status", "completed_at", "provider", "result_digest"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "result_id": {"type": "string", "pattern": "^WRES-[0-9A-F]{16}$"},
    "invocation_id": {"type": "string", "pattern": "^WINV-[0-9A-F]{16}$"},
    "invocation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "agent_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "failed"]},
    "completed_at": {"type": "string", "format": "date-time"},
    "provider": {
      "type": "object",
      "required": ["provider", "model_family", "resolved_model_version", "request_id_digest", "finish_reason"],
      "properties": {
        "provider": {"type": "string"},
        "model_family": {"type": "string"},
        "resolved_model_version": {"type": ["string", "null"]},
        "request_id_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "finish_reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "cost_usd", "measurement_note"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "measurement_note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "output_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "output_digests": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "error": {
      "type": "object",
      "required": ["kind", "message", "retryable"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
      "then": {"required": ["usage", "output_refs", "output_digests"], "not": {"required": ["error"]}}
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
      "then": {"required": ["error"], "not": {"anyOf": [{"required": ["output_refs"]}, {"required": ["output_digests"]}]}}
    }
  ],
  "additionalProperties": false
}

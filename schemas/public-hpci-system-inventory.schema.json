{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/public-hpci-system-inventory.schema.json",
  "title": "OpenFS Public HPCI System Inventory",
  "type": "object",
  "required": ["schema_version", "export_id", "status", "as_of", "research_status", "consensus_status", "scope_ja", "scope_en", "availability_semantics_ja", "availability_semantics_en", "sources", "systems", "operational_observations", "operational_data_products", "coverage_gaps", "caveat_ja", "caveat_en", "publication"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "export_id": {"type": "string", "pattern": "^HPCI-SYSTEM-INVENTORY-[A-Z0-9-]+$"},
    "status": {"const": "published"},
    "as_of": {"type": "string", "format": "date"},
    "research_status": {"enum": ["provisional", "accepted"]},
    "consensus_status": {"enum": ["incomplete", "accepted"]},
    "scope_ja": {"type": "string", "minLength": 1},
    "scope_en": {"type": "string", "minLength": 1},
    "availability_semantics_ja": {"type": "string", "minLength": 1},
    "availability_semantics_en": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "systems": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/system"}
    },
    "operational_observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/operationalObservation"}
    },
    "operational_data_products": {
      "type": "array",
      "items": {"$ref": "#/$defs/operationalDataProduct"}
    },
    "coverage_gaps": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/gap"}
    },
    "caveat_ja": {"type": "string", "minLength": 1},
    "caveat_en": {"type": "string", "minLength": 1},
    "publication": {"$ref": "#/$defs/publication"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["source_id", "title", "publisher", "url", "source_class"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^SRC-HPCI-SYS[0-9]{3}$"},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "published_at": {"type": "string", "format": "date"},
        "source_class": {"enum": ["government-official", "research-organization", "provider-official", "academic-primary"]}
      },
      "additionalProperties": false
    },
    "quarterBoundary": {
      "type": "object",
      "required": ["year", "quarter"],
      "properties": {
        "year": {"type": "integer", "minimum": 2020, "maximum": 2100},
        "quarter": {"enum": ["Q1", "Q2", "Q3", "Q4"]}
      },
      "additionalProperties": false
    },
    "availabilityWindow": {
      "type": "object",
      "required": ["window_id", "window_type", "start", "end", "timing_basis", "status", "source_ids"],
      "properties": {
        "window_id": {"type": "string", "pattern": "^WIN-HPCI-[A-Z0-9-]+$"},
        "window_type": {"enum": ["annual-call-availability", "service-lifecycle", "observed-operation"]},
        "start": {"$ref": "#/$defs/quarterBoundary"},
        "end": {"$ref": "#/$defs/quarterBoundary"},
        "timing_basis": {"enum": ["official-resource-list", "provider-announcement", "openfs-inference"]},
        "status": {"enum": ["confirmed", "planned", "provisional"]},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "specifications": {
      "type": "object",
      "required": ["processor", "accelerator", "node_count", "system_peak_pf", "node_peak_tf", "node_memory", "interconnect", "storage"],
      "properties": {
        "processor": {"type": ["string", "null"]},
        "accelerator": {"type": ["string", "null"]},
        "node_count": {"type": ["integer", "null"], "minimum": 1},
        "system_peak_pf": {"type": ["number", "null"], "minimum": 0},
        "node_peak_tf": {"type": ["number", "null"], "minimum": 0},
        "node_memory": {"type": ["string", "null"]},
        "interconnect": {"type": ["string", "null"]},
        "storage": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "system": {
      "type": "object",
      "required": ["system_id", "center_id", "provider_ja", "provider_en", "name_ja", "name_en", "architecture_class", "availability_windows", "specifications", "source_ids", "evidence_status"],
      "properties": {
        "system_id": {"type": "string", "pattern": "^HPCI-SYS-[A-Z0-9-]+$"},
        "center_id": {"type": "string", "pattern": "^CENTER-[A-Z0-9-]+$"},
        "provider_ja": {"type": "string", "minLength": 1},
        "provider_en": {"type": "string", "minLength": 1},
        "name_ja": {"type": "string", "minLength": 1},
        "name_en": {"type": "string", "minLength": 1},
        "architecture_class": {"enum": ["a64fx", "x86-cpu", "gpu", "cpu-gpu-integrated", "vector", "large-memory"]},
        "availability_windows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/availabilityWindow"}},
        "specifications": {"$ref": "#/$defs/specifications"},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "evidence_status": {"enum": ["official-architecture-map", "official-resource-page", "partial"]},
        "checked_on": {"type": "string", "format": "date"},
        "performance_note": {
          "type": "object", "additionalProperties": false,
          "required": ["note_ja", "note_en", "source_ids"],
          "properties": {
            "note_ja": {"type": "string", "minLength": 1},
            "note_en": {"type": "string", "minLength": 1},
            "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
          }
        },
        "lifecycle_milestone_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["roadmap_id", "milestone_id"],
            "properties": {
              "roadmap_id": {"type": "string", "pattern": "^RM-[A-Z0-9-]+$"},
              "milestone_id": {"type": "string", "pattern": "^MS-[A-Z0-9-]+$"}
            }
          }
        }
      },
      "additionalProperties": false
    },
    "operationalValue": {
      "type": "object",
      "required": ["kind", "value", "lower", "upper", "unit"],
      "properties": {
        "kind": {"enum": ["exact", "approximate", "range"]},
        "value": {"type": ["number", "null"], "minimum": 0},
        "lower": {"type": ["number", "null"], "minimum": 0},
        "upper": {"type": ["number", "null"], "minimum": 0},
        "unit": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "operationalObservation": {
      "type": "object",
      "required": ["observation_id", "system_ids", "metric", "period_start", "period_end", "value", "basis_ja", "basis_en", "comparability", "source_ids"],
      "properties": {
        "observation_id": {"type": "string", "pattern": "^OP-HPCI-[A-Z0-9-]+$"},
        "system_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^HPCI-SYS-[A-Z0-9-]+$"}},
        "metric": {"enum": ["design-power", "operating-power", "utilization", "job-count", "maximum-job-duration"]},
        "period_start": {"type": ["string", "null"], "format": "date"},
        "period_end": {"type": ["string", "null"], "format": "date"},
        "value": {"$ref": "#/$defs/operationalValue"},
        "basis_ja": {"type": "string", "minLength": 1},
        "basis_en": {"type": "string", "minLength": 1},
        "comparability": {"enum": ["system-specific", "period-specific"]},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "operationalDataProduct": {
      "type": "object",
      "required": ["product_id", "product_type", "system_ids", "period_start", "period_end", "record_count", "fields", "scope_ja", "scope_en", "caveat_ja", "caveat_en", "source_ids"],
      "properties": {
        "product_id": {"type": "string", "pattern": "^OPDATA-HPCI-[A-Z0-9-]+$"},
        "product_type": {"enum": ["public-dataset", "published-chart"]},
        "system_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^HPCI-SYS-[A-Z0-9-]+$"}},
        "period_start": {"type": ["string", "null"], "format": "date"},
        "period_end": {"type": ["string", "null"], "format": "date"},
        "record_count": {"type": ["integer", "null"], "minimum": 1},
        "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "scope_ja": {"type": "string", "minLength": 1},
        "scope_en": {"type": "string", "minLength": 1},
        "caveat_ja": {"type": "string", "minLength": 1},
        "caveat_en": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "gap": {
      "type": "object",
      "required": ["gap_id", "priority", "scope_ja", "scope_en", "impact_ja", "impact_en", "next_action_ja", "next_action_en", "status"],
      "properties": {
        "gap_id": {"type": "string", "pattern": "^GAP-HPCI-SYS-[0-9]{3}$"},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "scope_ja": {"type": "string", "minLength": 1},
        "scope_en": {"type": "string", "minLength": 1},
        "impact_ja": {"type": "string", "minLength": 1},
        "impact_en": {"type": "string", "minLength": 1},
        "next_action_ja": {"type": "string", "minLength": 1},
        "next_action_en": {"type": "string", "minLength": 1},
        "status": {"const": "open"}
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "required": ["information_classification", "publication_approved", "publication_decision_id", "human_approval_directive_id"],
      "properties": {
        "information_classification": {"const": "public"},
        "publication_approved": {"const": true},
        "publication_decision_id": {"type": "string", "minLength": 1},
        "human_approval_directive_id": {"type": "string", "pattern": "^DIR-[0-9]+$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

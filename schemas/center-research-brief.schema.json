{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/center-research-brief.schema.json",
  "title": "HPCI Center Research Brief",
  "type": "object",
  "required": ["schema_version", "brief_id", "run_id", "generated_at", "publication_status", "run_status", "web_coverage_status", "profile_coverage_status", "consensus_readiness", "summary", "transition_signals", "priority_followups", "centers", "sources", "caveats"],
  "properties": {
    "schema_version": {"type": "string"},
    "brief_id": {"type": "string"},
    "run_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "publication_status": {"const": "internal-review-only"},
    "run_status": {"type": "string"},
    "web_coverage_status": {"type": "string"},
    "profile_coverage_status": {"type": "string"},
    "consensus_readiness": {"type": "string"},
    "summary": {"type": "object"},
    "transition_signals": {"type": "array", "items": {"type": "object"}},
    "priority_followups": {"type": "array", "items": {"type": "object"}},
    "centers": {"type": "array", "items": {"type": "object"}},
    "sources": {"type": "array", "items": {"type": "object"}},
    "caveats": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

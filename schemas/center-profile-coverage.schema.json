{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/center-profile-coverage.schema.json",
  "title": "OpenFS Center Profile Coverage Report",
  "type": "object",
  "required": ["schema_version", "run_id", "monitor_id", "evaluated_at", "profile_coverage_status", "expected", "observed", "gaps", "caveat"],
  "properties": {
    "schema_version": {"type": "string"},
    "run_id": {"type": "string"},
    "monitor_id": {"type": "string"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "profile_coverage_status": {"enum": ["accepted-current", "incomplete"]},
    "expected": {"type": "object"},
    "observed": {"type": "object"},
    "gaps": {"type": "object"},
    "caveat": {"type": "string"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/conference-coverage.schema.json",
  "title": "Public conference coverage register",
  "type": "object",
  "required": [
    "schema_version",
    "export_id",
    "conference_id",
    "as_of",
    "checked_at",
    "research_status",
    "consensus_status",
    "title_ja",
    "title_en",
    "scope_ja",
    "scope_en",
    "caveat_ja",
    "caveat_en",
    "program_source_id",
    "expected_counts",
    "sources",
    "entries",
    "partnerships",
    "related_announcements",
    "coverage_gaps",
    "publication"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "export_id": {
      "type": "string",
      "minLength": 1
    },
    "conference_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "research_status": {
      "const": "provisional"
    },
    "consensus_status": {
      "const": "incomplete"
    },
    "title_ja": {
      "type": "string",
      "minLength": 1
    },
    "title_en": {
      "type": "string",
      "minLength": 1
    },
    "scope_ja": {
      "type": "string",
      "minLength": 1
    },
    "scope_en": {
      "type": "string",
      "minLength": 1
    },
    "caveat_ja": {
      "type": "string",
      "minLength": 1
    },
    "caveat_en": {
      "type": "string",
      "minLength": 1
    },
    "program_source_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_counts": {
      "type": "object",
      "required": [
        "technical",
        "tutorial",
        "keynote",
        "poster"
      ],
      "properties": {
        "technical": {
          "type": "integer"
        },
        "tutorial": {
          "type": "integer"
        },
        "keynote": {
          "type": "integer"
        },
        "poster": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "title",
          "publisher",
          "url",
          "role",
          "retrieval_status",
          "locator",
          "origin_group"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "role": {
            "enum": [
              "program",
              "discovery",
              "primary"
            ]
          },
          "retrieval_status": {
            "enum": [
              "read",
              "abstract-read",
              "blocked",
              "empty"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "origin_group": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entry_id",
          "kind",
          "label_ja",
          "label_en",
          "presenter_organizations",
          "coauthor_organizations",
          "primary_topic_id",
          "related_topic_ids",
          "technical_item_ids",
          "source_ids",
          "coverage_state",
          "gap_ja",
          "gap_en",
          "next_action_ja",
          "next_action_en"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "pattern": "^HC[0-9]{2}-(T|C|K|P)[0-9]{2}$"
          },
          "kind": {
            "enum": [
              "technical",
              "tutorial",
              "keynote",
              "poster"
            ]
          },
          "label_ja": {
            "type": "string",
            "minLength": 1
          },
          "label_en": {
            "type": "string",
            "minLength": 1
          },
          "presenter_organizations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "coauthor_organizations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "primary_topic_id": {
            "type": "string",
            "minLength": 1
          },
          "related_topic_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "technical_item_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "coverage_state": {
            "enum": [
              "program-only",
              "related-primary-checked",
              "abstract-only"
            ]
          },
          "gap_ja": {
            "type": "string",
            "minLength": 1
          },
          "gap_en": {
            "type": "string",
            "minLength": 1
          },
          "next_action_ja": {
            "type": "string",
            "minLength": 1
          },
          "next_action_en": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "partnerships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "organizations",
          "entry_ids",
          "source_ids"
        ],
        "properties": {
          "organizations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "entry_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "related_announcements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label_ja",
          "label_en",
          "topic_id",
          "technical_item_id",
          "source_ids"
        ],
        "properties": {
          "label_ja": {
            "type": "string",
            "minLength": 1
          },
          "label_en": {
            "type": "string",
            "minLength": 1
          },
          "topic_id": {
            "type": "string",
            "minLength": 1
          },
          "technical_item_id": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gap_id",
          "statement_ja",
          "statement_en",
          "source_ids"
        ],
        "properties": {
          "gap_id": {
            "type": "string",
            "minLength": 1
          },
          "statement_ja": {
            "type": "string",
            "minLength": 1
          },
          "statement_en": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "publication": {
      "$ref": "https://hpci-cfsp.github.io/OpenFS/schemas/public-roadmap.schema.json#/$defs/publication"
    }
  },
  "additionalProperties": false
}

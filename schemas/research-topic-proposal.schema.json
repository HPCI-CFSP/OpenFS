{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/research-topic-proposal.schema.json",
  "title": "OpenFS Additive Research Topic Proposal",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "object_type",
    "change_type",
    "run_id",
    "origin_group_ids",
    "has_primary_source",
    "created_by_agent_id",
    "created_at",
    "catalog_delta",
    "candidate_topic",
    "query_plan",
    "falsification_queries"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "proposal_id": {"type": "string", "pattern": "^PRP-TOP-[0-9]{6}$"},
    "object_type": {"const": "research_topic"},
    "change_type": {"const": "additive"},
    "run_id": {"type": "string"},
    "origin_group_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2, "uniqueItems": true},
    "has_primary_source": {"const": true},
    "created_by_agent_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "catalog_delta": {
      "type": "object",
      "required": ["novelty", "hpci_impact", "overlap_analysis", "why_existing_topics_are_insufficient"],
      "properties": {
        "novelty": {"type": "string", "minLength": 1},
        "hpci_impact": {"type": "string", "minLength": 1},
        "overlap_analysis": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "why_existing_topics_are_insufficient": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "candidate_topic": {
      "type": "object",
      "required": ["topic_id", "domain", "catalog_category_id", "title_ja", "title_en", "research_questions", "evidence_expected", "outputs", "source_refs", "review_cadence"],
      "properties": {
        "topic_id": {"type": "string", "pattern": "^(ARCH|SSW|APP|CROSS)-[0-9]{2}$"},
        "domain": {"enum": ["architecture", "system-software", "applications", "cross-cutting"]},
        "catalog_category_id": {"enum": ["architecture-hardware", "system-software-data-platform", "applications-workloads", "operations-facilities-security", "access-governance", "planning-evaluation-research"]},
        "title_ja": {"type": "string", "minLength": 1},
        "title_en": {"type": "string", "minLength": 1},
        "research_questions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "evidence_expected": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "outputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 2, "uniqueItems": true},
        "review_cadence": {"enum": ["weekly", "monthly", "quarterly", "annual", "event-driven"]}
      },
      "additionalProperties": false
    },
    "query_plan": {
      "type": "object",
      "required": ["languages", "source_classes", "query_families", "maximum_unchecked_days"],
      "properties": {
        "languages": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "source_classes": {"type": "array", "items": {"type": "string"}, "minItems": 2, "uniqueItems": true},
        "query_families": {"type": "array", "items": {"type": "string"}, "minItems": 2, "uniqueItems": true},
        "maximum_unchecked_days": {"type": "integer", "minimum": 1, "maximum": 90}
      },
      "additionalProperties": false
    },
    "falsification_queries": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/catalog-taxonomy.schema.json",
  "title": "OpenFS Public Catalog Taxonomy",
  "type": "object",
  "required": ["schema_version", "taxonomy_id", "status", "categories"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "taxonomy_id": {"const": "CATALOG-TAXONOMY-001"},
    "status": {"const": "active"},
    "categories": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "category_id", "order", "title_ja", "title_en", "description_ja",
          "description_en", "display_prefix", "topic_ids", "topic_codes", "roadmap_ids"
        ],
        "properties": {
          "category_id": {
            "enum": [
              "architecture-hardware", "system-software", "applications",
              "operations-procurement", "access-governance", "cross-cutting"
            ]
          },
          "order": {"type": "integer", "minimum": 1, "maximum": 6},
          "title_ja": {"type": "string", "minLength": 1},
          "title_en": {"type": "string", "minLength": 1},
          "short_title_ja": {"type": "string", "minLength": 1, "maxLength": 12},
          "short_title_en": {"type": "string", "minLength": 1, "maxLength": 24},
          "description_ja": {"type": "string", "minLength": 1},
          "description_en": {"type": "string", "minLength": 1},
          "display_prefix": {"enum": ["ARCH", "SSW", "APP", "OPS", "GOV", "CROSS"]},
          "topic_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^(ARCH|SSW|APP|CROSS)-[0-9]{2}$"}
          },
          "topic_codes": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"pattern": "^(ARCH|SSW|APP|CROSS)-[0-9]{2}$"},
            "additionalProperties": {"type": "string", "pattern": "^(ARCH|SSW|APP|OPS|GOV|CROSS)-[0-9]{3}$"}
          },
          "roadmap_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^RM-[A-Z0-9-]+$"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

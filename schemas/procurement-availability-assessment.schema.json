{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/procurement-availability-assessment.schema.json",
  "title": "Candidate Procurement Availability Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment_id", "catalog_id", "as_of", "status", "research_status", "consensus_status", "jurisdiction", "required_acceptance_date", "assessments"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "assessment_id": {"type": "string", "pattern": "^AVAIL-[A-Z0-9-]+$"},
    "catalog_id": {"type": "string", "pattern": "^GPUCAT-[A-Z0-9-]+$"},
    "as_of": {"type": "string", "format": "date"},
    "status": {"const": "candidate"},
    "research_status": {"const": "provisional"},
    "consensus_status": {"const": "incomplete"},
    "jurisdiction": {"type": "string", "minLength": 2},
    "required_acceptance_date": {"type": "string", "format": "date"},
    "assessments": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_id", "availability_status", "sales_publication_date", "procurement_eligible_date", "earliest_delivery_date", "latest_delivery_date", "lead_time_weeks", "minimum_procurement_unit", "sales_channel_status", "support_status", "support_end_date", "evidence_checked_date", "constraints_ja", "constraints_en", "source_ids", "gap_ids"],
        "properties": {
          "product_id": {"type": "string", "pattern": "^GPU-[A-Z0-9-]+$"},
          "availability_status": {"enum": ["eligible", "conditional", "unknown", "ineligible"]},
          "sales_publication_date": {"type": ["string", "null"], "format": "date"},
          "procurement_eligible_date": {"type": ["string", "null"], "format": "date"},
          "earliest_delivery_date": {"type": ["string", "null"], "format": "date"},
          "latest_delivery_date": {"type": ["string", "null"], "format": "date"},
          "lead_time_weeks": {
            "type": "object",
            "additionalProperties": false,
            "required": ["optimistic", "baseline", "conservative"],
            "properties": {
              "optimistic": {"type": ["number", "null"], "minimum": 0},
              "baseline": {"type": ["number", "null"], "minimum": 0},
              "conservative": {"type": ["number", "null"], "minimum": 0}
            }
          },
          "minimum_procurement_unit": {"type": ["string", "null"], "enum": ["node", "tray", "rack", null]},
          "sales_channel_status": {"enum": ["confirmed", "unconfirmed", "unknown"]},
          "support_status": {"enum": ["confirmed", "unconfirmed", "unknown"]},
          "support_end_date": {"type": ["string", "null"], "format": "date"},
          "evidence_checked_date": {"type": "string", "format": "date"},
          "constraints_ja": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "constraints_en": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "gap_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^GAP-GPUCFG-[0-9]{3}$"}}
        }
      }
    }
  }
}

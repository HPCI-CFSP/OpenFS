{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/proposal.schema.json",
  "title": "OpenFS Proposal",
  "type": "object",
  "required": ["schema_version", "proposal_id", "object_type", "run_id", "origin_group_ids", "has_primary_source"],
  "properties": {
    "schema_version": {"type": "string"},
    "proposal_id": {"type": "string", "pattern": "^PRP-[A-Z]+-[0-9]{6}$"},
    "object_type": {"enum": ["evidence", "claim", "finding", "research_topic", "high_impact_recommendation"]},
    "run_id": {"type": "string"},
    "origin_group_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "has_primary_source": {"type": "boolean"},
    "artifact_id": {"type": "string"},
    "created_by_agent_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/activation-policy.schema.json",
  "title": "OpenFS Activation Policy",
  "type": "object",
  "required": ["schema_version", "research_web_security_policy_ref", "execution_security_profiles_ref", "production_security_profile_required", "required_workflow_gates", "required_production_components", "required_owner_controls", "production_monitor_minimum_manual_runs", "effect"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "research_web_security_policy_ref": {"const": "config/research-web-security-policy.json"},
    "execution_security_profiles_ref": {"const": "config/execution-security-profiles.json"},
    "production_security_profile_required": {"const": true},
    "required_workflow_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["control_id", "workflow_ref", "variable"],
        "properties": {
          "control_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "workflow_ref": {"type": "string", "pattern": "^\\.github/workflows/[^/]+\\.yml$"},
          "variable": {"type": "string", "pattern": "^OPENFS_[A-Z_]+$"}
        },
        "additionalProperties": false
      }
    },
    "required_production_components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["control_id", "path", "purpose", "minimum_size_bytes", "required_markers"],
        "properties": {
          "control_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "path": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "minimum_size_bytes": {"type": "integer", "minimum": 1},
          "required_markers": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "required_owner_controls": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "minItems": 1, "uniqueItems": true},
    "production_monitor_minimum_manual_runs": {"type": "integer", "minimum": 1},
    "effect": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

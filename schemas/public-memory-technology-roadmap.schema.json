{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/public-memory-technology-roadmap.schema.json",
  "title": "OpenFS Public Memory Technology Roadmap Export",
  "type": "object",
  "required": [
    "schema_version", "export_id", "status", "domain", "slug", "as_of", "title_ja", "title_en",
    "summary_ja", "summary_en", "horizon", "research_status", "coverage_status",
    "consensus_status", "technologies", "lanes", "sources", "coverage_gaps",
    "caveat_ja", "caveat_en", "publication"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "export_id": {"type": "string", "pattern": "^MEMORY-ROADMAP-EXPORT-[0-9]{3}$"},
    "status": {"const": "published"},
    "domain": {"enum": ["hardware", "system-software", "applications", "cross-cutting"]},
    "slug": {"type": "string", "pattern": "^[a-z0-9-]+(?:/[a-z0-9-]+)*$"},
    "as_of": {"type": "string", "format": "date"},
    "title_ja": {"type": "string", "minLength": 1},
    "title_en": {"type": "string", "minLength": 1},
    "summary_ja": {"type": "string", "minLength": 1},
    "summary_en": {"type": "string", "minLength": 1},
    "horizon": {
      "type": "object",
      "required": ["start_year", "end_year"],
      "properties": {
        "start_year": {"type": "integer", "minimum": 2020},
        "end_year": {"type": "integer", "minimum": 2020}
      },
      "additionalProperties": false
    },
    "research_status": {"enum": ["provisional", "accepted"]},
    "coverage_status": {"type": "string", "minLength": 1},
    "consensus_status": {"enum": ["incomplete", "accepted"]},
    "technologies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "technology_id", "group", "name_ja", "name_en", "summary_ja", "summary_en",
          "current_state_ja", "current_state_en", "hpci_implications_ja",
          "hpci_implications_en", "source_ids"
        ],
        "properties": {
          "technology_id": {"type": "string", "pattern": "^MEMTECH-[A-Z0-9-]+$"},
          "group": {"enum": ["memory-products", "3d-integration", "system-enablers"]},
          "name_ja": {"type": "string", "minLength": 1},
          "name_en": {"type": "string", "minLength": 1},
          "summary_ja": {"type": "string", "minLength": 1},
          "summary_en": {"type": "string", "minLength": 1},
          "current_state_ja": {"type": "string", "minLength": 1},
          "current_state_en": {"type": "string", "minLength": 1},
          "hpci_implications_ja": {"type": "string", "minLength": 1},
          "hpci_implications_en": {"type": "string", "minLength": 1},
          "source_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^SRC-MEM[0-9]{3}$"}
          }
        },
        "additionalProperties": false
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lane_id", "technology_id", "vendor", "scope_ja", "scope_en", "milestones"],
        "properties": {
          "lane_id": {"type": "string", "pattern": "^LANE-[A-Z0-9-]+$"},
          "technology_id": {"type": "string", "pattern": "^MEMTECH-[A-Z0-9-]+$"},
          "vendor": {"type": "string", "minLength": 1},
          "scope_ja": {"type": "string", "minLength": 1},
          "scope_en": {"type": "string", "minLength": 1},
          "milestones": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "milestone_id", "year", "maturity", "timing_basis", "label_ja",
                "label_en", "detail_ja", "detail_en", "source_ids"
              ],
              "properties": {
                "milestone_id": {"type": "string", "pattern": "^MS-[A-Z0-9-]+$"},
                "year": {"type": ["integer", "null"], "minimum": 2020},
                "maturity": {"enum": ["commercial", "sample", "standard", "target", "concept", "undated"]},
                "timing_basis": {"enum": ["observed", "standard-release", "vendor-target", "no-public-date"]},
                "label_ja": {"type": "string", "minLength": 1},
                "label_en": {"type": "string", "minLength": 1},
                "detail_ja": {"type": "string", "minLength": 1},
                "detail_en": {"type": "string", "minLength": 1},
                "source_ids": {
                  "type": "array", "minItems": 1, "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^SRC-MEM[0-9]{3}$"}
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "title", "publisher", "url", "source_class"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^SRC-MEM[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "published_at": {"type": "string", "format": "date"},
          "source_class": {"enum": ["vendor-official", "standards-body", "research-organization"]}
        },
        "additionalProperties": false
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap_id", "statement_ja", "statement_en"],
        "properties": {
          "gap_id": {"type": "string", "pattern": "^GAP-MEM[0-9]{3}$"},
          "statement_ja": {"type": "string", "minLength": 1},
          "statement_en": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "caveat_ja": {"type": "string", "minLength": 1},
    "caveat_en": {"type": "string", "minLength": 1},
    "publication": {
      "type": "object",
      "required": [
        "information_classification", "publication_approved", "publication_decision_id",
        "human_approval_directive_id"
      ],
      "properties": {
        "information_classification": {"const": "public"},
        "publication_approved": {"const": true},
        "publication_decision_id": {"type": "string", "minLength": 1},
        "human_approval_directive_id": {"type": "string", "pattern": "^DIR-[0-9]{6}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

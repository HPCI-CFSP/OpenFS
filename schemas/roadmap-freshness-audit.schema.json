{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/roadmap-freshness-audit.schema.json",
  "title": "OpenFS Roadmap Freshness Audit",
  "type": "object",
  "required": ["schema_version", "export_id", "status", "audit_id", "as_of", "generated_at", "method_ja", "method_en", "caveat_ja", "caveat_en", "summary", "roadmap_summaries", "attention_items", "publication"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "export_id": {"const": "ROADMAP-FRESHNESS-AUDIT-001"},
    "status": {"const": "published"},
    "audit_id": {"type": "string", "pattern": "^RFA-[0-9]{8}-[0-9]{3}$"},
    "as_of": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "method_ja": {"type": "string", "minLength": 1},
    "method_en": {"type": "string", "minLength": 1},
    "caveat_ja": {"type": "string", "minLength": 1},
    "caveat_en": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "required": ["roadmap_count", "milestone_count", "source_count", "attention_count", "critical", "high", "medium", "low", "no_public_date_milestones", "past_target_rechecks", "future_observed_conflicts", "source_date_unknown", "source_attention"],
      "properties": {
        "roadmap_count": {"type": "integer", "minimum": 1},
        "milestone_count": {"type": "integer", "minimum": 1},
        "source_count": {"type": "integer", "minimum": 1},
        "attention_count": {"type": "integer", "minimum": 0},
        "critical": {"type": "integer", "minimum": 0},
        "high": {"type": "integer", "minimum": 0},
        "medium": {"type": "integer", "minimum": 0},
        "low": {"type": "integer", "minimum": 0},
        "no_public_date_milestones": {"type": "integer", "minimum": 0},
        "past_target_rechecks": {"type": "integer", "minimum": 0},
        "future_observed_conflicts": {"type": "integer", "minimum": 0},
        "source_date_unknown": {"type": "integer", "minimum": 0},
        "source_attention": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "roadmap_summaries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["roadmap_id", "milestone_count", "source_count", "attention_count", "critical", "high", "medium", "low"],
        "properties": {
          "roadmap_id": {"type": "string", "pattern": "^RM-[A-Z0-9-]+$"},
          "milestone_count": {"type": "integer", "minimum": 1},
          "source_count": {"type": "integer", "minimum": 1},
          "attention_count": {"type": "integer", "minimum": 0},
          "critical": {"type": "integer", "minimum": 0},
          "high": {"type": "integer", "minimum": 0},
          "medium": {"type": "integer", "minimum": 0},
          "low": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "attention_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attention_id", "roadmap_id", "object_type", "object_id", "severity", "reason", "reason_ja", "reason_en", "next_action_ja", "next_action_en"],
        "properties": {
          "attention_id": {"type": "string", "pattern": "^RFAI-[0-9]{4}$"},
          "roadmap_id": {"type": "string", "pattern": "^RM-[A-Z0-9-]+$"},
          "object_type": {"enum": ["milestone", "source"]},
          "object_id": {"type": "string", "pattern": "^(MS|SRC)-[A-Z0-9-]+$"},
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "reason": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "reason_ja": {"type": "string", "minLength": 1},
          "reason_en": {"type": "string", "minLength": 1},
          "next_action_ja": {"type": "string", "minLength": 1},
          "next_action_en": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "publication": {
      "type": "object",
      "required": ["information_classification", "publication_approved", "publication_decision_id", "human_approval_directive_id"],
      "properties": {
        "information_classification": {"const": "public"},
        "publication_approved": {"const": true},
        "publication_decision_id": {"const": "PUBDEC-20260826-005"},
        "human_approval_directive_id": {"const": "DIR-900006"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

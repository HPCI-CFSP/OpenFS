{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/benchmark-result-bundle.schema.json",
  "title": "OpenFS Reproducible Benchmark Result Bundle",
  "type": "object",
  "required": ["schema_version", "bundle_id", "status", "roadmap_gap_refs", "campaign", "workload", "configurations", "runs", "aggregates", "failure_recovery_trials", "porting_records", "acceptance", "provenance", "consensus_status"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "bundle_id": {"type": "string", "pattern": "^BMR-[A-Z0-9-]+$"},
    "status": {"enum": ["provisional", "review-candidate", "accepted"]},
    "roadmap_gap_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["GAP-COMP-004", "GAP-MEM003", "GAP-PORT-004", "GAP-PORT-006", "GAP-WORK-003"]}
    },
    "campaign": {
      "type": "object",
      "required": ["name", "version", "objective_ja", "objective_en", "protocol_uri", "protocol_digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "objective_ja": {"type": "string", "minLength": 1},
        "objective_en": {"type": "string", "minLength": 1},
        "protocol_uri": {"type": "string", "format": "uri"},
        "protocol_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "workload": {
      "type": "object",
      "required": ["workload_id", "version", "input_id", "input_digest", "scale", "precision", "correctness_metric", "correctness_tolerance"],
      "properties": {
        "workload_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "input_id": {"type": "string", "minLength": 1},
        "input_digest": {"$ref": "#/$defs/digest"},
        "scale": {"type": "string", "minLength": 1},
        "precision": {"type": "string", "minLength": 1},
        "correctness_metric": {"type": "string", "minLength": 1},
        "correctness_tolerance": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "configurations": {
      "type": "array", "minItems": 2,
      "items": {"$ref": "#/$defs/configuration"}
    },
    "runs": {
      "type": "array", "minItems": 6,
      "items": {"$ref": "#/$defs/run"}
    },
    "aggregates": {
      "type": "array", "minItems": 2,
      "items": {"$ref": "#/$defs/aggregate"}
    },
    "failure_recovery_trials": {
      "type": "array",
      "items": {"$ref": "#/$defs/failureTrial"}
    },
    "porting_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/portingRecord"}
    },
    "acceptance": {
      "type": "object",
      "required": ["minimum_configurations", "minimum_runs_per_configuration", "minimum_institutions", "minimum_origin_groups", "maximum_correctness_error"],
      "properties": {
        "minimum_configurations": {"type": "integer", "minimum": 2},
        "minimum_runs_per_configuration": {"type": "integer", "minimum": 3},
        "minimum_institutions": {"type": "integer", "minimum": 2},
        "minimum_origin_groups": {"type": "integer", "minimum": 2},
        "maximum_correctness_error": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["created_at", "base_commit", "agent_id", "model_identity", "harness_repository", "harness_commit", "raw_data_uri", "raw_data_digest"],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "base_commit": {"$ref": "#/$defs/commit"},
        "agent_id": {"type": "string", "minLength": 1},
        "model_identity": {"type": "string", "minLength": 1},
        "harness_repository": {"type": "string", "format": "uri"},
        "harness_commit": {"$ref": "#/$defs/commit"},
        "raw_data_uri": {"type": "string", "format": "uri"},
        "raw_data_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "consensus_status": {"enum": ["incomplete", "accepted"]}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "configuration": {
      "type": "object",
      "required": ["configuration_id", "institution_id", "origin_group_id", "system_id", "hardware", "software", "measurement_boundary"],
      "properties": {
        "configuration_id": {"type": "string", "pattern": "^CFG-[A-Z0-9-]+$"},
        "institution_id": {"type": "string", "minLength": 1},
        "origin_group_id": {"type": "string", "minLength": 1},
        "system_id": {"type": "string", "minLength": 1},
        "hardware": {
          "type": "object",
          "required": ["cpu", "accelerator", "memory", "interconnect", "node_count"],
          "properties": {
            "cpu": {"type": "string", "minLength": 1},
            "accelerator": {"type": "string", "minLength": 1},
            "memory": {"type": "string", "minLength": 1},
            "interconnect": {"type": "string", "minLength": 1},
            "node_count": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "software": {
          "type": "object",
          "required": ["os", "kernel", "compiler", "mpi", "fabric_provider", "libraries", "environment_digest"],
          "properties": {
            "os": {"type": "string", "minLength": 1},
            "kernel": {"type": "string", "minLength": 1},
            "compiler": {"type": "string", "minLength": 1},
            "mpi": {"type": "string", "minLength": 1},
            "fabric_provider": {"type": "string", "minLength": 1},
            "libraries": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "environment_digest": {"$ref": "#/$defs/digest"}
          },
          "additionalProperties": false
        },
        "measurement_boundary": {"enum": ["device", "node", "rack", "facility"]}
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["run_id", "configuration_id", "repetition", "started_at", "ended_at", "success", "correctness_error", "correctness_pass", "elapsed_seconds", "energy_joules", "result_digest", "log_digest"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^RUN-[A-Z0-9-]+$"},
        "configuration_id": {"type": "string", "pattern": "^CFG-[A-Z0-9-]+$"},
        "repetition": {"type": "integer", "minimum": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "success": {"type": "boolean"},
        "correctness_error": {"type": "number", "minimum": 0},
        "correctness_pass": {"type": "boolean"},
        "elapsed_seconds": {"type": "number", "exclusiveMinimum": 0},
        "energy_joules": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "result_digest": {"$ref": "#/$defs/digest"},
        "log_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "aggregate": {
      "type": "object",
      "required": ["configuration_id", "valid_run_count", "median_elapsed_seconds", "median_energy_joules"],
      "properties": {
        "configuration_id": {"type": "string", "pattern": "^CFG-[A-Z0-9-]+$"},
        "valid_run_count": {"type": "integer", "minimum": 0},
        "median_elapsed_seconds": {"type": "number", "exclusiveMinimum": 0},
        "median_energy_joules": {"type": ["number", "null"], "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "failureTrial": {
      "type": "object",
      "required": ["trial_id", "configuration_id", "fault_type", "detected", "recovered", "correct_result", "recovery_seconds", "log_digest"],
      "properties": {
        "trial_id": {"type": "string", "pattern": "^FAIL-[A-Z0-9-]+$"},
        "configuration_id": {"type": "string", "pattern": "^CFG-[A-Z0-9-]+$"},
        "fault_type": {"type": "string", "minLength": 1},
        "detected": {"type": "boolean"},
        "recovered": {"type": "boolean"},
        "correct_result": {"type": "boolean"},
        "recovery_seconds": {"type": ["number", "null"], "minimum": 0},
        "log_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "portingRecord": {
      "type": "object",
      "required": ["configuration_id", "backend", "baseline_code_digest", "ported_code_digest", "person_hours", "changed_lines", "build_log_digest"],
      "properties": {
        "configuration_id": {"type": "string", "pattern": "^CFG-[A-Z0-9-]+$"},
        "backend": {"type": "string", "minLength": 1},
        "baseline_code_digest": {"$ref": "#/$defs/digest"},
        "ported_code_digest": {"$ref": "#/$defs/digest"},
        "person_hours": {"type": "number", "minimum": 0},
        "changed_lines": {"type": "integer", "minimum": 0},
        "build_log_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

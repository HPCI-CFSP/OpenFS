{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/public-analytics.schema.json",
  "title": "OpenFS Public Analytics Configuration",
  "type": "object",
  "required": [
    "schema_version", "analytics_id", "status", "measurement_id", "production_hostname",
    "production_path_prefix", "consent_mode", "storage_key", "privacy_path",
    "collect_query_string", "collect_search_terms", "advertising_features",
    "allowed_events"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "analytics_id": {"const": "PUBLIC-ANALYTICS-001"},
    "status": {"enum": ["enabled", "disabled"]},
    "measurement_id": {"type": "string", "pattern": "^G-[A-Z0-9]+$"},
    "production_hostname": {"type": "string", "const": "hpci-cfsp.github.io"},
    "production_path_prefix": {"type": "string", "const": "/OpenFS/"},
    "consent_mode": {"const": "basic-opt-in"},
    "storage_key": {"type": "string", "pattern": "^openfs-[a-z0-9-]+$"},
    "privacy_path": {"type": "string", "const": "privacy/"},
    "collect_query_string": {"const": false},
    "collect_search_terms": {"const": false},
    "advertising_features": {"const": false},
    "allowed_events": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["page_view"]},
      "const": ["page_view"]
    }
  },
  "additionalProperties": false
}

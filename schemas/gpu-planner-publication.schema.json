{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/gpu-planner-publication.schema.json",
  "title": "OpenFS GPU Planner Publication Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "publication_id",
    "status",
    "page_status",
    "information_classification",
    "research_status",
    "consensus_status",
    "procurement_use",
    "as_of",
    "route",
    "title_ja",
    "title_en",
    "summary_ja",
    "summary_en",
    "analytics_external_transmission",
    "source_artifacts",
    "publication"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "publication_id": {"const": "GPU-PLANNER-PUBLICATION-001"},
    "status": {"const": "published"},
    "page_status": {"const": "candidate"},
    "information_classification": {"const": "public"},
    "research_status": {"const": "provisional"},
    "consensus_status": {"const": "incomplete"},
    "procurement_use": {"const": "prohibited"},
    "as_of": {"type": "string", "format": "date"},
    "route": {"const": "candidate/gpu-centric-ai4s/"},
    "title_ja": {"type": "string", "minLength": 1},
    "title_en": {"type": "string", "minLength": 1},
    "summary_ja": {"type": "string", "minLength": 1},
    "summary_en": {"type": "string", "minLength": 1},
    "analytics_external_transmission": {"const": false},
    "source_artifacts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["role", "artifact_id", "path", "sha256"],
        "properties": {
          "role": {"enum": ["request", "architecture", "product-catalog", "availability", "what-if-template"]},
          "artifact_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^proposals/(planning-requests|reference-architectures|gpu-product-catalogs|procurement-availability|component-cost-inputs)/[A-Za-z0-9._-]+\\.json$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "publication": {
      "type": "object",
      "required": ["information_classification", "publication_approved", "publication_decision_id", "human_approval_directive_id"],
      "properties": {
        "information_classification": {"const": "public"},
        "publication_approved": {"const": true},
        "publication_decision_id": {"type": "string", "minLength": 1},
        "human_approval_directive_id": {"type": "string", "pattern": "^DIR-[0-9]{6}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

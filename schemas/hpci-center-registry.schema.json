{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/hpci-center-registry.schema.json",
  "title": "OpenFS HPCI Center Registry",
  "type": "object",
  "required": ["schema_version", "registry_id", "title", "as_of", "authority", "scope_note", "default_profile_fields", "centers"],
  "properties": {
    "schema_version": {"type": "string"},
    "registry_id": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date"},
    "authority": {
      "type": "object",
      "required": ["title", "publisher", "url", "retrieved_at"],
      "properties": {
        "title": {"type": "string"},
        "publisher": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "scope_note": {"type": "string"},
    "default_profile_fields": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "centers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["center_id", "name_ja", "name_en", "participation_mode", "official_url"],
        "properties": {
          "center_id": {"type": "string", "pattern": "^CENTER-[A-Z0-9-]+$"},
          "name_ja": {"type": "string", "minLength": 1},
          "name_en": {"type": "string", "minLength": 1},
          "participation_mode": {"enum": ["central-allocation", "provider-managed-allocation"]},
          "official_url": {"type": "string", "format": "uri"},
          "profile_fields": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

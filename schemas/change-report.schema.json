{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/change-report.schema.json",
  "title": "OpenFS Source Change Report",
  "type": "object",
  "required": ["schema_version", "run_id", "previous_run_id", "generated_at", "comparison_basis", "summary", "changes", "caveat"],
  "properties": {
    "schema_version": {"type": "string"},
    "run_id": {"type": "string"},
    "previous_run_id": {"type": ["string", "null"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "comparison_basis": {"type": "object"},
    "summary": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["canonical_url", "classification", "current_source_ref", "previous_source_ref", "current_fingerprint", "previous_fingerprint", "reasons"],
        "properties": {
          "canonical_url": {"type": "string", "format": "uri"},
          "observation_query": {"type": ["string", "null"]},
          "classification": {"enum": ["new", "changed", "unchanged", "unavailable", "not-observed"]},
          "current_source_ref": {"type": ["string", "null"]},
          "previous_source_ref": {"type": ["string", "null"]},
          "current_fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "previous_fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "reasons": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "caveat": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

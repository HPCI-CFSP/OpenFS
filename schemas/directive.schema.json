{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/directive.schema.json",
  "title": "OpenFS Human Directive",
  "type": "object",
  "required": ["schema_version", "directive_id", "title", "instruction", "priority", "status", "submitted_by", "submitted_at"],
  "properties": {
    "schema_version": {"type": "string"},
    "directive_id": {"type": "string", "pattern": "^DIR-[0-9]{6}$"},
    "directive_type": {"enum": ["research-instruction", "publication-approval", "canonical-status", "governance"]},
    "application_mode": {"enum": ["once", "recurring"]},
    "title": {"type": "string"},
    "instruction": {"type": "string"},
    "priority": {"enum": ["low", "normal", "high", "urgent"]},
    "status": {"enum": ["proposed", "approved", "scheduled", "running", "completed", "rejected", "expired"]},
    "submitted_by": {"type": "string"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "scope": {"type": "array", "items": {"type": "string"}},
    "processed_run_ids": {"type": "array", "items": {"type": "string"}},
    "result_decision_ids": {"type": "array", "items": {"type": "string"}},
    "publication_targets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "claim_targets": {
      "type": "array",
      "items": {"type": "string", "pattern": "^CLM-[0-9]{6}$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "canonical_status_action": {"enum": ["withdrawn", "superseded"]},
    "canonical_status_reason": {"type": "string", "minLength": 1},
    "replacement_claim_id": {"type": "string", "pattern": "^CLM-[0-9]{6}$"},
    "public_information_confirmed": {"type": "boolean"},
    "source": {
      "type": "object",
      "required": ["kind", "url", "content_digest", "untrusted_input"],
      "properties": {
        "kind": {"const": "github-issue"},
        "issue_number": {"type": "integer", "minimum": 1},
        "url": {"type": "string", "format": "uri"},
        "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "untrusted_input": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"directive_type": {"const": "canonical-status"}}, "required": ["directive_type"]},
      "then": {
        "required": ["claim_targets", "canonical_status_action", "canonical_status_reason", "public_information_confirmed"],
        "properties": {"public_information_confirmed": {"const": true}}
      }
    },
    {
      "if": {"properties": {"canonical_status_action": {"const": "superseded"}}, "required": ["canonical_status_action"]},
      "then": {"required": ["replacement_claim_id"]}
    },
    {
      "if": {"properties": {"canonical_status_action": {"const": "withdrawn"}}, "required": ["canonical_status_action"]},
      "then": {"not": {"required": ["replacement_claim_id"]}}
    },
    {
      "if": {"properties": {"application_mode": {"const": "recurring"}}, "required": ["application_mode"]},
      "then": {"required": ["expires_at"]}
    }
  ],
  "additionalProperties": false
}

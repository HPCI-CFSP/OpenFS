{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/source-catalog-map.schema.json",
  "title": "OpenFS Generated Source-to-Catalog Map",
  "type": "object",
  "required": ["schema_version", "map_id", "generated_from", "unmapped_catalog_source_ids", "entries"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "map_id": {"const": "SOURCE-CATALOG-MAP-001"},
    "generated_from": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "unmapped_catalog_source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["canonical_url", "title", "publisher", "source_classes", "roadmap_source_refs", "catalog_source_refs", "topic_links", "roadmap_ids", "track_ids", "watch_ids"],
        "properties": {
          "canonical_url": {"type": "string", "format": "uri"},
          "conference_entry_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^HC[0-9]{2}-(T|C|K|P)[0-9]{2}$"}},
          "title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "source_classes": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "roadmap_source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["roadmap_id", "source_id"],
              "properties": {
                "roadmap_id": {"type": "string", "pattern": "^RM-[A-Z0-9-]+$"},
                "source_id": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "catalog_source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_id", "topic_ids"],
              "properties": {
                "source_id": {"type": "string", "minLength": 1},
                "topic_ids": {
                  "type": "array",
                  "items": {"type": "string", "pattern": "^(ARCH|SSW|APP|CROSS)-[0-9]{2}$"},
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          },
          "topic_links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["topic_id", "mapping_basis"],
              "properties": {
                "topic_id": {"type": "string", "pattern": "^(ARCH|SSW|APP|CROSS)-[0-9]{2}$"},
                "mapping_basis": {"enum": ["direct-topic-evidence", "roadmap-family-context", "conference-program-context"]}
              },
              "additionalProperties": false
            }
          },
          "roadmap_ids": {"type": "array", "items": {"type": "string", "pattern": "^RM-[A-Z0-9-]+$"}, "uniqueItems": true},
          "track_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "watch_ids": {"type": "array", "items": {"type": "string", "pattern": "^WATCH-[A-Z0-9-]+$"}, "uniqueItems": true}
        },
        "anyOf": [
          {"required": ["conference_entry_refs"]},
          {"properties": {"roadmap_source_refs": {"minItems": 1}}},
          {"properties": {"catalog_source_refs": {"minItems": 1}}}
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

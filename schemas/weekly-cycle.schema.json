{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/weekly-cycle.schema.json",
  "title": "OpenFS Weekly Coordination Plan",
  "type": "object",
  "required": ["schema_version", "cycle_id", "week", "generated_at", "mode", "status", "blockers", "monitors", "issue"],
  "properties": {
    "schema_version": {"type": "string"},
    "cycle_id": {"type": "string"},
    "week": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["pilot", "production"]},
    "status": {"enum": ["ready", "blocked"]},
    "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "monitors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["monitor_id", "task_id", "mode", "suggested_run_id", "previous_run_id", "previous_run_status", "pending_directive_ids"],
        "properties": {
          "monitor_id": {"type": "string"},
          "task_id": {"type": "string"},
          "mode": {"enum": ["pilot", "production"]},
          "suggested_run_id": {"type": "string"},
          "previous_run_id": {"type": ["string", "null"]},
          "previous_run_status": {"type": ["string", "null"]},
          "pending_directive_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "production_readiness": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "operational_readiness": {
      "type": "object",
      "required": ["status", "blockers", "owner_actions", "checks", "enabled_monitor_count", "ready_enabled_monitor_count", "detail_ref"],
      "properties": {
        "status": {"enum": ["ready", "blocked"]},
        "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "owner_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action_id", "summary", "refs"],
            "properties": {
              "action_id": {"type": "string"},
              "summary": {"type": "string"},
              "refs": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "enabled_monitor_count": {"type": "integer", "minimum": 0},
        "ready_enabled_monitor_count": {"type": "integer", "minimum": 0},
        "detail_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "required": ["title", "body", "labels", "deduplication_marker"],
      "properties": {
        "title": {"type": "string"},
        "body": {"type": "string"},
        "labels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "deduplication_marker": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

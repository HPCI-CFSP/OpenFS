{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/discovery-no-result.schema.json",
  "title": "OpenFS Discovery No-result Record",
  "type": "object",
  "required": ["schema_version", "result_id", "object_type", "run_id", "work_item_id", "created_by_agent_id", "created_at", "query_receipt", "assignment_scope", "disposition"],
  "properties": {
    "schema_version": {"type": "string"},
    "result_id": {"type": "string", "pattern": "^NORESULT-[A-F0-9]{12}$"},
    "object_type": {"const": "discovery_no_result"},
    "run_id": {"type": "string"},
    "work_item_id": {"type": "string"},
    "created_by_agent_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "query_receipt": {"type": "object"},
    "assignment_scope": {"type": "object"},
    "disposition": {"const": "no-eligible-responsive-source"}
  },
  "additionalProperties": false
}

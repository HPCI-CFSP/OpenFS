{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/research-baseline.schema.json",
  "title": "OpenFS Research Baseline",
  "type": "object",
  "required": ["schema_version", "baseline_id", "baseline_status", "complete", "source_refs", "source_corpus", "topics", "open_gap_ids"],
  "properties": {
    "schema_version": {"type": "string"},
    "baseline_id": {"type": "string"},
    "baseline_status": {"enum": ["draft", "initial-from-current-corpus", "reviewed", "superseded"]},
    "complete": {"type": "boolean"},
    "derived_at": {"type": "string", "format": "date"},
    "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "source_corpus": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "title", "filename", "sha256", "origin_group_id", "lineage_family", "availability"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^FSBASE-SRC-[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "origin_group_id": {"type": "string", "pattern": "^FSBASE-ORG-[0-9]{3}$"},
          "lineage_family": {"type": "string", "minLength": 1},
          "availability": {"enum": ["external-reference", "registered-public-url", "repository"]}
        },
        "additionalProperties": false
      }
    },
    "open_gap_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["topic_id", "domain", "title_ja", "research_questions", "evidence_expected", "outputs", "source_refs", "status", "review_cadence"],
        "properties": {
          "topic_id": {"type": "string", "pattern": "^(ARCH|SSW|APP|CROSS)-[0-9]{2}$"},
          "domain": {"enum": ["architecture", "system-software", "applications", "cross-cutting"]},
          "title_ja": {"type": "string", "minLength": 1},
          "research_questions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "evidence_expected": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "outputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "status": {"enum": ["not-started", "partial", "reviewed", "retired"]},
          "review_cadence": {"enum": ["weekly", "monthly", "quarterly", "annual", "event-driven"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

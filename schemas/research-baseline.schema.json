{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/research-baseline.schema.json",
  "title": "OpenFS Research Baseline",
  "type": "object",
  "required": ["schema_version", "baseline_id", "baseline_status", "catalog_revision", "complete", "initial_catalog", "source_refs", "source_corpus", "topics", "open_gap_ids"],
  "properties": {
    "schema_version": {"type": "string"},
    "baseline_id": {"type": "string"},
    "baseline_status": {"enum": ["draft", "initial-from-current-corpus", "reviewed", "superseded"]},
    "catalog_revision": {"type": "integer", "minimum": 1},
    "complete": {"type": "boolean"},
    "derived_at": {"type": "string", "format": "date"},
    "initial_catalog": {
      "type": "object",
      "required": ["baseline_id", "topic_count", "topic_ids", "retention_rule"],
      "properties": {
        "baseline_id": {"const": "FSBASE-001"},
        "topic_count": {"const": 30},
        "topic_ids": {
          "type": "array",
          "minItems": 30,
          "maxItems": 30,
          "items": {"type": "string", "pattern": "^(ARCH|SSW|APP|CROSS)-[0-9]{2}$"},
          "uniqueItems": true
        },
        "retention_rule": {"const": "protected-no-silent-removal"}
      },
      "additionalProperties": false
    },
    "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "source_corpus": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "title", "filename", "sha256", "origin_group_id", "lineage_family", "availability"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^FSBASE-SRC-[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "origin_group_id": {"type": "string", "pattern": "^FSBASE-ORG-[0-9]{3}$"},
          "lineage_family": {"type": "string", "minLength": 1},
          "availability": {"enum": ["external-reference", "registered-public-url", "repository"]},
          "public_url": {"type": "string", "format": "uri"},
          "source_page_url": {"type": "string", "format": "uri"},
          "fiscal_year": {"type": "integer", "minimum": 2022},
          "team": {"type": "string", "minLength": 1},
          "part": {"type": "string", "minLength": 1},
          "page_count": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "open_gap_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["topic_id", "domain", "title_ja", "research_questions", "evidence_expected", "outputs", "source_refs", "status", "review_cadence"],
        "properties": {
          "topic_id": {"type": "string", "pattern": "^(ARCH|SSW|APP|CROSS)-[0-9]{2}$"},
          "domain": {"enum": ["architecture", "system-software", "applications", "cross-cutting"]},
          "title_ja": {"type": "string", "minLength": 1},
          "summary_ja": {"type": "string", "minLength": 1},
          "summary_en": {"type": "string", "minLength": 1},
          "related_topic_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(ARCH|SSW|APP|CROSS)-[0-9]{2}$"}},
          "research_units": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["unit_id", "title_ja", "title_en", "question_ja", "question_en", "status", "evidence_section_ids"],
              "properties": {
                "unit_id": {"type": "string", "pattern": "^(ARCH|SSW|APP|CROSS)-[0-9]{2}-U[0-9]{2}$"},
                "title_ja": {"type": "string", "minLength": 1},
                "title_en": {"type": "string", "minLength": 1},
                "question_ja": {"type": "string", "minLength": 1},
                "question_en": {"type": "string", "minLength": 1},
                "status": {"enum": ["not-started", "partial", "reviewed"]},
                "latest_update_id": {"type": "string", "pattern": "^RUP-[0-9]{6}$"},
                "last_researched_at": {"type": "string", "format": "date-time"},
                "evidence_section_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^TDS-[A-Z0-9-]+$"}}
              },
              "additionalProperties": false
            }
          },
          "research_questions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "evidence_expected": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "outputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "status": {"enum": ["not-started", "partial", "reviewed", "retired"]},
          "review_cadence": {"enum": ["weekly", "monthly", "quarterly", "annual", "event-driven"]},
          "catalog_origin": {"enum": ["human-directive", "ai-consensus"]},
          "proposal_id": {"type": "string"},
          "added_by_decision_id": {"type": "string"},
          "retirement": {
            "type": "object",
            "required": ["kind", "rationale_ja", "rationale_en"],
            "properties": {
              "kind": {"enum": ["merged", "harness-owned", "output-owned"]},
              "successor_topic_ids": {
                "type": "array",
                "items": {"type": "string", "pattern": "^(ARCH|SSW|APP|CROSS)-[0-9]{2}$"},
                "uniqueItems": true
              },
              "successor_paths": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              },
              "rationale_ja": {"type": "string", "minLength": 1},
              "rationale_en": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

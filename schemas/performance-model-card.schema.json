{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/performance-model-card.schema.json",
  "title": "OpenFS Performance Model Card",
  "type": "object",
  "required": ["schema_version", "model_card_id", "status", "roadmap_gap_refs", "model", "inputs", "outputs", "applicability", "calibration_dataset_ids", "validations", "acceptance", "provenance", "consensus_status"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "model_card_id": {"type": "string", "pattern": "^PMCARD-[A-Z0-9-]+$"},
    "status": {"enum": ["provisional", "review-candidate", "accepted"]},
    "roadmap_gap_refs": {
      "type": "array",
      "contains": {"const": "GAP-WORK-003"},
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^GAP-[A-Z0-9-]+$"}
    },
    "model": {
      "type": "object",
      "required": ["name", "version", "model_type", "description_ja", "description_en"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "model_type": {"enum": ["analytical", "simulation", "statistical", "machine-learning", "hybrid"]},
        "description_ja": {"type": "string", "minLength": 1},
        "description_en": {"type": "string", "minLength": 1},
        "equation_ja": {"type": "string", "minLength": 1},
        "equation_en": {"type": "string", "minLength": 1},
        "implementation_uri": {"type": "string", "format": "uri"},
        "implementation_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "additionalProperties": false,
      "anyOf": [
        {"required": ["equation_ja", "equation_en"]},
        {"required": ["implementation_uri", "implementation_digest"]}
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/quantityDefinition"},
          {"properties": {"quantity_id": {"pattern": "^IN-[A-Z0-9-]+$"}}}
        ]
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/quantityDefinition"},
          {"properties": {"quantity_id": {"pattern": "^OUT-[A-Z0-9-]+$"}}}
        ]
      }
    },
    "applicability": {
      "type": "object",
      "required": ["architecture_ids", "workload_ids", "scale_min", "scale_max", "exclusions_ja", "exclusions_en"],
      "properties": {
        "architecture_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "workload_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "scale_min": {"type": "number", "minimum": 0},
        "scale_max": {"type": "number", "exclusiveMinimum": 0},
        "exclusions_ja": {"type": "string", "minLength": 1},
        "exclusions_en": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "calibration_dataset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "validations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/validationMeasurement"}
    },
    "acceptance": {
      "type": "object",
      "required": ["minimum_systems", "minimum_workloads", "minimum_origin_groups", "metric_thresholds"],
      "properties": {
        "minimum_systems": {"type": "integer", "minimum": 2},
        "minimum_workloads": {"type": "integer", "minimum": 2},
        "minimum_origin_groups": {"type": "integer", "minimum": 2},
        "metric_thresholds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["output_id", "maximum_relative_error"],
            "properties": {
              "output_id": {"type": "string", "pattern": "^OUT-[A-Z0-9-]+$"},
              "maximum_relative_error": {"type": "number", "minimum": 0}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["created_at", "base_commit", "agent_id", "model_identity", "skill_version", "evidence_refs"],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "base_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "agent_id": {"type": "string", "minLength": 1},
        "model_identity": {"type": "string", "minLength": 1},
        "skill_version": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "consensus_status": {"enum": ["incomplete", "accepted"]}
  },
  "$defs": {
    "quantityDefinition": {
      "type": "object",
      "required": ["quantity_id", "name_ja", "name_en", "unit"],
      "properties": {
        "quantity_id": {"type": "string", "pattern": "^(IN|OUT)-[A-Z0-9-]+$"},
        "name_ja": {"type": "string", "minLength": 1},
        "name_en": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "validationMeasurement": {
      "type": "object",
      "required": ["measurement_id", "dataset_id", "system_id", "workload_id", "origin_group_id", "output_id", "predicted", "observed", "unit", "absolute_error", "relative_error", "measurement_source_ids"],
      "properties": {
        "measurement_id": {"type": "string", "pattern": "^PMVAL-[A-Z0-9-]+$"},
        "dataset_id": {"type": "string", "minLength": 1},
        "system_id": {"type": "string", "minLength": 1},
        "workload_id": {"type": "string", "minLength": 1},
        "origin_group_id": {"type": "string", "minLength": 1},
        "output_id": {"type": "string", "pattern": "^OUT-[A-Z0-9-]+$"},
        "predicted": {"type": "number"},
        "observed": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "absolute_error": {"type": "number", "minimum": 0},
        "relative_error": {"type": ["number", "null"], "minimum": 0},
        "measurement_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

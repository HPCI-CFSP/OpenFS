        "metric_id": {"enum": ["time-to-solution", "parallel-efficiency", "throughput", "energy-to-solution", "domain-rate", "relative-speedup", "achieved-flops"]},
        "estimate": {"$ref": "#/$defs/estimate"},
        "model_card_id": {"type": "string", "pattern": "^PMCARD-[A-Z0-9-]+$"},

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/consensus-review-package.schema.json",
  "title": "OpenFS Consensus Review Package",
  "type": "object",
  "required": [
    "schema_version", "package_id", "status", "object_type", "base_commit",
    "created_at", "portfolio_summary", "consensus_policy", "artifact_manifest", "review_units",
    "independence_requirements", "known_limitations", "submission"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "package_id": {"type": "string", "pattern": "^CRP-[A-Z0-9-]+$"},
    "status": {"const": "awaiting-independent-review"},
    "object_type": {"const": "high-impact-recommendation"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "portfolio_summary": {
      "type": "object",
      "required": ["roadmap_count", "milestone_count", "source_count", "coverage_gap_count", "dependency_count", "external_constraint_count", "scenario_count"],
      "properties": {
        "roadmap_count": {"type": "integer", "minimum": 1},
        "milestone_count": {"type": "integer", "minimum": 1},
        "source_count": {"type": "integer", "minimum": 1},
        "coverage_gap_count": {"type": "integer", "minimum": 1},
        "dependency_count": {"type": "integer", "minimum": 1},
        "external_constraint_count": {"type": "integer", "minimum": 0},
        "scenario_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "consensus_policy": {
      "type": "object",
      "required": [
        "policy_id", "minimum_assessments", "minimum_support",
        "minimum_support_independence_groups", "minimum_origin_groups",
        "minimum_model_families", "minimum_providers",
        "require_primary_source", "require_falsification_review",
        "require_human_decision", "block_on_critical_objection"
      ],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "minimum_assessments": {"type": "integer", "minimum": 2},
        "minimum_support": {"type": "integer", "minimum": 2},
        "minimum_support_independence_groups": {"type": "integer", "minimum": 2},
        "minimum_origin_groups": {"type": "integer", "minimum": 2},
        "minimum_model_families": {"type": "integer", "minimum": 2},
        "minimum_providers": {"type": "integer", "minimum": 2},
        "require_primary_source": {"type": "boolean"},
        "require_falsification_review": {"type": "boolean"},
        "require_human_decision": {"type": "boolean"},
        "block_on_critical_objection": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "artifact_manifest": {
      "type": "array", "minItems": 10, "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "object_type"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "object_type": {
            "enum": [
              "roadmap", "source-audit", "evidence-audit", "freshness-audit", "gap-queue", "dependency-register",
              "scenario-set", "policy", "registry", "schema", "tool", "workflow", "directive",
              "skill", "operations-guide", "presentation", "monitor", "query-plan"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "review_units": {
      "type": "array", "minItems": 9, "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["unit_id", "kind", "title_ja", "title_en", "artifact_paths", "selectors", "primary_source_requirements", "required_checks", "falsification_prompts_ja", "falsification_prompts_en"],
        "properties": {
          "unit_id": {"type": "string", "pattern": "^CRU-[A-Z0-9-]+$"},
          "kind": {"enum": ["roadmap", "cross-roadmap", "coverage-gap", "scenario", "publication-assurance"]},
          "title_ja": {"type": "string", "minLength": 1},
          "title_en": {"type": "string", "minLength": 1},
          "artifact_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "selectors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "primary_source_requirements": {
            "type": "array", "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["selector", "source_options"],
              "properties": {
                "selector": {"type": "string", "pattern": "^MS-[A-Z0-9-]+$"},
                "source_options": {
                  "type": "array", "minItems": 1, "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "required": ["source_id", "source_url", "source_class"],
                    "properties": {
                      "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
                      "source_url": {"type": "string", "format": "uri"},
                      "source_class": {"enum": ["vendor-official", "standards-body", "government-official", "research-organization", "project-official", "academic-primary"]}
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "required_checks": {
            "type": "array", "minItems": 4, "uniqueItems": true,
            "items": {"enum": ["source-identity", "citation-entailment", "temporal-validity", "scope-alignment", "coverage-gap-completeness", "dependency-validity", "scenario-coherence", "fallback-viability", "publication-boundary", "review-protocol-integrity"]}
          },
          "falsification_prompts_ja": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "falsification_prompts_en": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "independence_requirements": {
      "type": "object",
      "required": ["author_group", "reviewer_rule_ja", "reviewer_rule_en", "disallowed_as_independent"],
      "properties": {
        "author_group": {"type": "string", "minLength": 1},
        "reviewer_rule_ja": {"type": "string", "minLength": 1},
        "reviewer_rule_en": {"type": "string", "minLength": 1},
        "disallowed_as_independent": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "known_limitations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["limitation_id", "description_ja", "description_en", "effect"],
        "properties": {
          "limitation_id": {"type": "string", "pattern": "^LIM-[A-Z0-9-]+$"},
          "description_ja": {"type": "string", "minLength": 1},
          "description_en": {"type": "string", "minLength": 1},
          "effect": {"enum": ["blocks-consensus", "requires-caveat", "requires-human-decision"]}
        },
        "additionalProperties": false
      }
    },
    "submission": {
      "type": "object",
      "required": ["assessment_directory", "assessment_schema", "gate_command"],
      "properties": {
        "assessment_directory": {"type": "string", "minLength": 1},
        "assessment_schema": {"const": "schemas/consensus-package-review.schema.json"},
        "gate_command": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/coverage-report.schema.json",
  "title": "OpenFS Declared-Scope Coverage Report",
  "type": "object",
  "required": ["schema_version", "run_id", "monitor_id", "evaluated_at", "coverage_status", "monitor_snapshot_match", "expected", "observed", "gaps", "caveat"],
  "properties": {
    "schema_version": {"type": "string"},
    "run_id": {"type": "string"},
    "monitor_id": {"type": "string"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "coverage_status": {"enum": ["met-declared-scope", "incomplete"]},
    "monitor_snapshot_match": {"type": "boolean"},
    "expected": {"type": "object"},
    "observed": {"type": "object"},
    "gaps": {"type": "object"},
    "caveat": {"type": "string"}
  },
  "additionalProperties": false
}

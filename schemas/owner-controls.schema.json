{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/owner-controls.schema.json",
  "title": "OpenFS Owner Control Attestations",
  "type": "object",
  "required": ["schema_version", "controls", "warning"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["control_id", "status", "verified_by", "verified_at", "expires_at", "evidence_note"],
        "properties": {
          "control_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "status": {"enum": ["unverified", "verified", "failed"]},
          "verified_by": {"type": ["string", "null"], "minLength": 1},
          "verified_at": {"type": ["string", "null"], "format": "date-time"},
          "expires_at": {"type": ["string", "null"], "format": "date-time"},
          "evidence_note": {"type": "string"}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
            "then": {
              "properties": {
                "verified_by": {"type": "string", "minLength": 1},
                "verified_at": {"type": "string", "format": "date-time"},
                "expires_at": {"type": "string", "format": "date-time"},
                "evidence_note": {"type": "string", "minLength": 1}
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "warning": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/roadmap-dependency-register.schema.json",
  "title": "OpenFS Cross-Roadmap Dependency Register",
  "type": "object",
  "required": [
    "schema_version", "export_id", "status", "as_of", "title_ja", "title_en",
    "summary_ja", "summary_en", "consensus_status", "dependencies",
    "external_constraints", "publication"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "export_id": {"const": "ROADMAP-DEPENDENCY-REGISTER-001"},
    "status": {"const": "published"},
    "as_of": {"type": "string", "format": "date"},
    "title_ja": {"type": "string", "minLength": 1},
    "title_en": {"type": "string", "minLength": 1},
    "summary_ja": {"type": "string", "minLength": 1},
    "summary_en": {"type": "string", "minLength": 1},
    "consensus_status": {"const": "incomplete"},
    "dependencies": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "dependency_id", "upstream_roadmap_id", "downstream_roadmap_id",
          "relationship", "criticality", "basis", "statement_ja", "statement_en",
          "decision_impact_ja", "decision_impact_en", "risk_if_late_ja",
          "risk_if_late_en", "source_ids", "source_dependency_ids", "gate_refs",
          "coverage_gap_refs"
        ],
        "properties": {
          "dependency_id": {"type": "string", "pattern": "^XDEP-[A-Z0-9-]+$"},
          "upstream_roadmap_id": {"type": "string", "pattern": "^RM-[A-Z0-9-]+$"},
          "downstream_roadmap_id": {"type": "string", "pattern": "^RM-[A-Z0-9-]+$"},
          "relationship": {"enum": ["requires", "informs", "constrains", "enables", "co-evolves"]},
          "criticality": {"enum": ["high", "medium", "low"]},
          "basis": {"enum": ["evidence-backed", "openfs-assessment"]},
          "statement_ja": {"type": "string", "minLength": 1},
          "statement_en": {"type": "string", "minLength": 1},
          "decision_impact_ja": {"type": "string", "minLength": 1},
          "decision_impact_en": {"type": "string", "minLength": 1},
          "risk_if_late_ja": {"type": "string", "minLength": 1},
          "risk_if_late_en": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"}},
          "source_dependency_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^DEP-[A-Z0-9-]+$"}},
          "gate_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^MS-[A-Z0-9-]+$"}},
          "coverage_gap_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^GAP-[A-Z0-9-]+$"}}
        },
        "additionalProperties": false
      }
    },
    "external_constraints": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["constraint_id", "name_ja", "name_en", "impact_ja", "impact_en", "status"],
        "properties": {
          "constraint_id": {"type": "string", "pattern": "^EXT-[A-Z0-9-]+$"},
          "name_ja": {"type": "string", "minLength": 1},
          "name_en": {"type": "string", "minLength": 1},
          "impact_ja": {"type": "string", "minLength": 1},
          "impact_en": {"type": "string", "minLength": 1},
          "status": {"const": "coverage-gap"}
        },
        "additionalProperties": false
      }
    },
    "publication": {
      "type": "object",
      "required": ["information_classification", "publication_approved", "publication_decision_id", "human_approval_directive_id"],
      "properties": {
        "information_classification": {"const": "public"},
        "publication_approved": {"const": true},
        "publication_decision_id": {"const": "PUBDEC-20260826-003"},
        "human_approval_directive_id": {"const": "DIR-900006"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

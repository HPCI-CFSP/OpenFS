{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/published-scenario-set.schema.json",
  "title": "OpenFS Published System Planning Option Set",
  "type": "object",
  "required": ["schema_version", "set_id", "as_of", "status", "title_ja", "title_en", "notice_ja", "notice_en", "consensus_status", "budget_reference_cases", "decision_evidence_contracts", "scenarios"],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "set_id": {"const": "SCNSET-HPCI-P0-001"},
    "as_of": {"type": "string", "format": "date"},
    "status": {"const": "published"},
    "title_ja": {"type": "string", "minLength": 1},
    "title_en": {"type": "string", "minLength": 1},
    "notice_ja": {"type": "string", "minLength": 1},
    "notice_en": {"type": "string", "minLength": 1},
    "consensus_status": {"const": "incomplete"},
    "budget_reference_cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["case_id", "name_ja", "name_en", "budget_oku_jpy", "scope_ja", "scope_en", "configuration_ja", "configuration_en", "source_title", "source_publisher", "source_url", "public_date", "comparability_note_ja", "comparability_note_en"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^BREF-[A-Z0-9-]+$"},
          "name_ja": {"type": "string", "minLength": 1},
          "name_en": {"type": "string", "minLength": 1},
          "budget_oku_jpy": {"type": ["number", "null"], "minimum": 0},
          "scope_ja": {"type": "string", "minLength": 1},
          "scope_en": {"type": "string", "minLength": 1},
          "configuration_ja": {"type": "string", "minLength": 1},
          "configuration_en": {"type": "string", "minLength": 1},
          "source_title": {"type": "string", "minLength": 1},
          "source_publisher": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri"},
          "public_date": {"type": "string", "format": "date"},
          "comparability_note_ja": {"type": "string", "minLength": 1},
          "comparability_note_en": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "decision_evidence_contracts": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "https://hpci-cfsp.github.io/OpenFS/schemas/system-scenario.schema.json#/$defs/decisionEvidenceContract"}
    },
    "scenarios": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "https://hpci-cfsp.github.io/OpenFS/schemas/system-scenario.schema.json"}
    }
  },
  "additionalProperties": false
}

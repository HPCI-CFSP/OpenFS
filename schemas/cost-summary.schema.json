{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/cost-summary.schema.json",
  "title": "OpenFS Run Cost Summary",
  "type": "object",
  "required": ["currency", "measurement_status", "reported_total_usd", "reported_executions", "unreported_executions", "reported_input_tokens", "reported_output_tokens"],
  "properties": {
    "currency": {"const": "USD"},
    "measurement_status": {"enum": ["unreported", "partial", "complete"]},
    "reported_total_usd": {"type": ["number", "null"], "minimum": 0},
    "reported_executions": {"type": "integer", "minimum": 0},
    "unreported_executions": {"type": "integer", "minimum": 0},
    "reported_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "reported_output_tokens": {"type": ["integer", "null"], "minimum": 0}
  },
  "additionalProperties": false
}

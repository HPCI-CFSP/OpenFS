{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/roadmap-gap-query-overrides.schema.json",
  "title": "OpenFS Roadmap Gap Query Overrides",
  "type": "object",
  "required": ["schema_version", "override_set_id", "status", "as_of", "entries"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "override_set_id": {"type": "string", "pattern": "^RGQO-[A-Z0-9-]+$"},
    "status": {"const": "active"},
    "as_of": {"type": "string", "format": "date"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gap_id", "query_seeds", "source_classes", "closure_plan"],
        "properties": {
          "gap_id": {"type": "string", "pattern": "^GAP-[A-Z0-9-]+$"},
          "query_seeds": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["language", "query"],
              "properties": {
                "language": {"enum": ["ja", "en"]},
                "query": {"type": "string", "minLength": 8}
              },
              "additionalProperties": false
            }
          },
          "source_classes": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "closure_plan": {"$ref": "#/$defs/closurePlan"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "closurePlan": {
      "type": "object",
      "required": ["minimum_independent_origin_groups", "requires_consensus_gate", "criteria"],
      "properties": {
        "minimum_independent_origin_groups": {"type": "integer", "minimum": 2},
        "requires_consensus_gate": {"const": true},
        "criteria": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["criterion_id", "verification_method", "requirement_ja", "requirement_en"],
            "properties": {
              "criterion_id": {"type": "string", "pattern": "^GAP-[A-Z0-9-]+-C[0-9]+$"},
              "verification_method": {"enum": ["evidence-review", "reproducible-measurement", "conformance-test", "authority-confirmation", "consensus-quorum"]},
              "requirement_ja": {"type": "string", "minLength": 1},
              "requirement_en": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

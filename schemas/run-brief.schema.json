{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/run-brief.schema.json",
  "title": "OpenFS Run Review Brief",
  "type": "object",
  "required": ["schema_version", "brief_id", "run_id", "generated_at", "publication_status", "review_status", "run_status", "research_status", "coverage_status", "consensus_readiness", "source_change_summary", "claim_outcomes", "claims", "caveats"],
  "properties": {
    "schema_version": {"type": "string"},
    "brief_id": {"type": "string"},
    "run_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "publication_status": {"const": "internal-review-only"},
    "review_status": {"enum": ["human-review-required", "eligible-for-publication-review"]},
    "run_status": {"type": "string"},
    "research_status": {"type": "string"},
    "coverage_status": {"type": "string"},
    "consensus_readiness": {"type": "string"},
    "source_change_summary": {"type": "object"},
    "claim_outcomes": {"type": "object"},
    "claims": {"type": "array", "items": {"type": "object"}},
    "caveats": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/run-approval.schema.json",
  "title": "OpenFS Human Pilot Run Approval",
  "type": "object",
  "required": ["schema_version", "approval_id", "run_id", "monitor_id", "status", "manifest_digest", "brief_ref", "brief_digest", "reviewed_by", "reviewed_at", "checks", "notes"],
  "properties": {
    "schema_version": {"type": "string"},
    "approval_id": {"type": "string", "pattern": "^RUNAPP-[A-Z0-9-]+$"},
    "run_id": {"type": "string", "pattern": "^RUN-[A-Z0-9-]+$"},
    "monitor_id": {"type": "string", "pattern": "^MON-[A-Z0-9-]+$"},
    "status": {"enum": ["reviewed-pass", "reviewed-fail", "revoked"]},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "brief_ref": {"type": "string"},
    "brief_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewed_by": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "checks": {
      "type": "object",
      "required": ["public_information_boundary", "citation_sample", "coverage", "false_positive_review", "dissent_review", "cost_review"],
      "properties": {
        "public_information_boundary": {"type": "boolean"},
        "citation_sample": {"type": "boolean"},
        "coverage": {"type": "boolean"},
        "false_positive_review": {"type": "boolean"},
        "dissent_review": {"type": "boolean"},
        "cost_review": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}

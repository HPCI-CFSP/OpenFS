{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/source-discovery-result.schema.json",
  "title": "OpenFS Source Discovery Result",
  "type": "object",
  "required": ["schema_version", "proposal_id", "object_type", "run_id", "work_item_id", "created_by_agent_id", "created_at", "query_receipt", "source_receipt", "source_lineage", "candidate_passages", "capture_digest"],
  "properties": {
    "schema_version": {"type": "string"},
    "proposal_id": {"type": "string"},
    "object_type": {"const": "source"},
    "run_id": {"type": "string"},
    "work_item_id": {"type": "string"},
    "created_by_agent_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "query_receipt": {"type": "object"},
    "source_receipt": {"type": "object"},
    "source_lineage": {"type": "object"},
    "candidate_passages": {"type": "array", "items": {"type": "object"}},
    "capture_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}

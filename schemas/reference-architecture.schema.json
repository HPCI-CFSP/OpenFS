{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/reference-architecture.schema.json",
  "title": "Candidate Reference Architecture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "architecture_id", "status", "research_status", "consensus_status", "information_classification", "title_ja", "title_en", "definition_ja", "definition_en", "compatible_policy_ids", "procurement_unit_types", "component_roles", "connections", "constraints", "vendor_profiles", "source_ids", "coverage_gaps"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "architecture_id": {"const": "ARCH-GPU-CENTRIC-AI4S-001"},
    "status": {"const": "candidate"},
    "research_status": {"const": "provisional"},
    "consensus_status": {"const": "incomplete"},
    "information_classification": {"const": "public"},
    "title_ja": {"type": "string", "minLength": 1},
    "title_en": {"type": "string", "minLength": 1},
    "definition_ja": {"type": "string", "minLength": 1},
    "definition_en": {"type": "string", "minLength": 1},
    "compatible_policy_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^POL-SYS-[A-Z0-9-]+$"}},
    "procurement_unit_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["node", "tray", "rack"]}},
    "component_roles": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role_id", "category", "required", "sizing_basis", "redundancy_basis_ja", "redundancy_basis_en"],
        "properties": {
          "role_id": {"type": "string", "pattern": "^ROLE-[A-Z0-9-]+$"},
          "category": {"enum": ["compute", "scale-up", "scale-out", "storage", "service", "management", "facility", "integration", "maintenance"]},
          "required": {"type": "boolean"},
          "sizing_basis": {"type": "string", "minLength": 1},
          "redundancy_basis_ja": {"type": "string", "minLength": 1},
          "redundancy_basis_en": {"type": "string", "minLength": 1}
        }
      }
    },
    "connections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["connection_id", "from_role_id", "to_role_id", "purpose_ja", "purpose_en"],
        "properties": {
          "connection_id": {"type": "string", "pattern": "^CONN-[A-Z0-9-]+$"},
          "from_role_id": {"type": "string", "pattern": "^ROLE-[A-Z0-9-]+$"},
          "to_role_id": {"type": "string", "pattern": "^ROLE-[A-Z0-9-]+$"},
          "purpose_ja": {"type": "string", "minLength": 1},
          "purpose_en": {"type": "string", "minLength": 1}
        }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constraint_id", "metric", "operator", "source"],
        "properties": {
          "constraint_id": {"type": "string", "pattern": "^CONSTRAINT-[A-Z0-9-]+$"},
          "metric": {"type": "string", "minLength": 1},
          "operator": {"enum": ["less-than-or-equal", "greater-than-or-equal", "integer", "available-by"]},
          "source": {"enum": ["planning-request", "product-catalog", "availability-assessment", "cost-input"]}
        }
      }
    },
    "vendor_profiles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vendor", "compute_stack", "communication_stack", "software_stack", "required_role_ids"],
        "properties": {
          "vendor": {"enum": ["NVIDIA", "AMD"]},
          "compute_stack": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "communication_stack": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "software_stack": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "required_role_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ROLE-[A-Z0-9-]+$"}}
        }
      }
    },
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "coverage_gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "priority", "statement_ja", "statement_en", "blocking"],
        "properties": {
          "gap_id": {"type": "string", "pattern": "^GAP-GPUCFG-[0-9]{3}$"},
          "priority": {"enum": ["P0", "P1", "P2"]},
          "statement_ja": {"type": "string", "minLength": 1},
          "statement_en": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"}
        }
      }
    }
  }
}

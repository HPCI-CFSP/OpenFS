{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/roadmap-source-audit.schema.json",
  "title": "OpenFS Roadmap Source Reachability Audit",
  "type": "object",
  "required": ["schema_version", "export_id", "status", "audit_id", "as_of", "checked_at", "method", "method_ja", "method_en", "caveat_ja", "caveat_en", "user_agent", "summary", "results", "publication"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "export_id": {"const": "ROADMAP-SOURCE-AUDIT-001"},
    "status": {"const": "published"},
    "audit_id": {"type": "string", "pattern": "^RSA-[0-9]{8}-[0-9]{3}$"},
    "as_of": {"type": "string", "format": "date"},
    "checked_at": {"type": "string", "format": "date-time"},
    "method": {"type": "string", "minLength": 1},
    "method_ja": {"type": "string", "minLength": 1},
    "method_en": {"type": "string", "minLength": 1},
    "caveat_ja": {"type": "string", "minLength": 1},
    "caveat_en": {"type": "string", "minLength": 1},
    "user_agent": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "required": ["source_count", "reachable", "access-restricted", "missing", "timeout", "error"],
      "properties": {
        "source_count": {"type": "integer", "minimum": 1},
        "reachable": {"type": "integer", "minimum": 0},
        "access-restricted": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "timeout": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["roadmap_id", "source_id", "url", "status", "http_status", "final_url", "content_type"],
        "properties": {
          "roadmap_id": {"type": "string", "pattern": "^RM-[A-Z0-9-]+$"},
          "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
          "url": {"type": "string", "format": "uri"},
          "status": {"enum": ["reachable", "access-restricted", "missing", "timeout", "error"]},
          "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
          "final_url": {"type": "string", "format": "uri"},
          "content_type": {"type": ["string", "null"]},
          "error_kind": {"type": "string", "minLength": 1},
          "error_detail": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "publication": {
      "type": "object",
      "required": ["information_classification", "publication_approved", "publication_decision_id", "human_approval_directive_id"],
      "properties": {
        "information_classification": {"const": "public"},
        "publication_approved": {"const": true},
        "publication_decision_id": {"const": "PUBDEC-20260826-002"},
        "human_approval_directive_id": {"const": "DIR-900006"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/gpu-product-catalog.schema.json",
  "title": "Candidate GPU Product Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "as_of", "status", "research_status", "consensus_status", "products"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "catalog_id": {"type": "string", "pattern": "^GPUCAT-[A-Z0-9-]+$"},
    "as_of": {"type": "string", "format": "date"},
    "status": {"const": "candidate"},
    "research_status": {"const": "provisional"},
    "consensus_status": {"const": "incomplete"},
    "products": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/product"}
    }
  },
  "$defs": {
    "quantityOrNull": {"type": ["number", "null"], "minimum": 0},
    "datePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "precision"],
      "properties": {
        "value": {"type": "string", "format": "date"},
        "precision": {"enum": ["day", "month", "quarter", "half-year", "year"]}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "vendor", "family", "model", "architecture", "generation_rank", "form_factor", "lifecycle_status", "technical_specs", "procurement_units", "events", "source_ids", "evidence_checked_date", "confidence"],
      "properties": {
        "product_id": {"type": "string", "pattern": "^GPU-[A-Z0-9-]+$"},
        "vendor": {"enum": ["NVIDIA", "AMD"]},
        "family": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "generation_rank": {"type": "integer", "minimum": 1},
        "form_factor": {"type": "string", "minLength": 1},
        "lifecycle_status": {"enum": ["announced", "sampling", "volume-shipment", "procurement-observed", "operating", "end-of-life", "unknown"]},
        "technical_specs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hbm_capacity_gib", "hbm_bandwidth_tb_s", "board_power_kw", "fp64_tflops", "low_precision_pflops"],
          "properties": {
            "hbm_capacity_gib": {"$ref": "#/$defs/quantityOrNull"},
            "hbm_bandwidth_tb_s": {"$ref": "#/$defs/quantityOrNull"},
            "board_power_kw": {"$ref": "#/$defs/quantityOrNull"},
            "fp64_tflops": {"$ref": "#/$defs/quantityOrNull"},
            "low_precision_pflops": {"$ref": "#/$defs/quantityOrNull"}
          }
        },
        "procurement_units": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["unit_type", "gpus_per_unit", "host_cpus_per_unit", "units_per_rack", "source_ids"],
            "properties": {
              "unit_type": {"enum": ["node", "tray", "rack"]},
              "gpus_per_unit": {"type": ["integer", "null"], "minimum": 1},
              "host_cpus_per_unit": {"type": ["integer", "null"], "minimum": 0},
              "units_per_rack": {"type": ["integer", "null"], "minimum": 1},
              "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event_type", "date", "claim_status", "source_ids"],
            "properties": {
              "event_type": {"enum": ["announcement", "sampling", "volume-shipment", "partner-availability", "procurement-observed", "operation-start"]},
              "date": {"$ref": "#/$defs/datePoint"},
              "claim_status": {"enum": ["observed", "official-plan", "provisional-outlook"]},
              "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_checked_date": {"type": "string", "format": "date"},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    }
  }
}

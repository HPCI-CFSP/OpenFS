{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpci-cfsp.github.io/OpenFS/schemas/roadmap-portfolio.schema.json",
  "title": "OpenFS Roadmap Portfolio",
  "type": "object",
  "required": [
    "schema_version", "portfolio_id", "baseline_id", "planning_horizon",
    "design_rule_ja", "design_rule_en", "roadmap_families"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "portfolio_id": {"type": "string", "pattern": "^ROADMAP-PORTFOLIO-[0-9]{3}$"},
    "baseline_id": {"type": "string", "minLength": 1},
    "planning_horizon": {
      "type": "object",
      "required": ["start_year", "end_year", "default_granularity"],
      "properties": {
        "start_year": {"type": "integer", "minimum": 2020},
        "end_year": {"type": "integer", "minimum": 2020},
        "default_granularity": {"const": "quarter"}
      },
      "additionalProperties": false
    },
    "design_rule_ja": {"type": "string", "minLength": 1},
    "design_rule_en": {"type": "string", "minLength": 1},
    "roadmap_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "roadmap_id", "slug", "domain", "title_ja", "title_en",
          "purpose_ja", "purpose_en", "priority", "status",
          "review_cadence", "source_topic_ids", "expected_outputs_ja",
          "expected_outputs_en", "published_artifact_ids"
        ],
        "properties": {
          "roadmap_id": {"type": "string", "pattern": "^RM-[A-Z0-9-]+$"},
          "slug": {"type": "string", "pattern": "^[a-z0-9-]+(?:/[a-z0-9-]+)*$"},
          "domain": {"enum": ["hardware", "system-software", "applications", "cross-cutting"]},
          "title_ja": {"type": "string", "minLength": 1},
          "title_en": {"type": "string", "minLength": 1},
          "purpose_ja": {"type": "string", "minLength": 1},
          "purpose_en": {"type": "string", "minLength": 1},
          "priority": {"enum": ["P0", "P1", "P2"]},
          "status": {"enum": ["planned", "in-research", "published"]},
          "review_cadence": {"enum": ["weekly", "monthly", "quarterly", "semiannual"]},
          "source_topic_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^(ARCH|SSW|APP|CROSS)-[0-9]{2}$"}
          },
          "expected_outputs_ja": {
            "type": "array", "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "expected_outputs_en": {
            "type": "array", "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "published_artifact_ids": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

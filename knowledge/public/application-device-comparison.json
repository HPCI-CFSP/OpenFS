  "methods": [
    {
      "name": "Calibrated Roofline",
      "note_ja": "カーネルごとの演算量・メモリ転送量と基準機の実測から校正します。ホスト処理、転送、同期、I/Oは分け、重複計上を避けます。ピークFLOPS比だけでは外挿しません。",
      "note_en": "Calibrate each kernel with FLOPs, memory traffic and measured baseline time. Separate host work, transfers, synchronization and I/O, without double-counting overlap. Peak-FLOPS ratios alone are insufficient.",
      "source_id": "ROOFLINE"
    },
    {
      "name": "CPU ECM",
      "note_ja": "CPUではキャッシュ階層、命令実行、データ転送の重なりを扱うECMも候補です。未校正のCPU/GPU間外挿は行いません。",
      "note_en": "ECM is an option for CPU cache hierarchies, in-core execution and transfer overlap. No uncalibrated CPU-to-GPU extrapolation.",
      "source_id": "ECM"
    },
    {
      "name": "Backtesting",
      "note_ja": "対象機の実測値を校正に使わず予測し、同一条件の実測との差を評価します。基準機による予測のばらつきは予測精度ではありません。幅は感度範囲か統計的区間かを明示し、世代の近さだけで精度を保証しません。",
      "note_en": "Hold target measurements out of calibration and compare predictions against matching measurements. Variation across baselines is not accuracy. Label sensitivity ranges separately from statistical intervals; adjacent generations do not guarantee accuracy.",
      "source_id": "ROOFLINE"
    }
  ],
